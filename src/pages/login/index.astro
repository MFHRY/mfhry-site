---
import Base from '../../layouts/Base.astro';
---
<Base title="登录">
  <h1>登录</h1>
  <p class="muted">
    登录之后，排行榜和墙都用这个身份：榜上显示用户名而不是 IP，墙上发帖带名字和头像。
  </p>

  <div class="card">
    <div class="who" id="who" hidden>
      <span class="badge" id="badge">邮箱</span>
      <span class="avatar" id="avatar">?</span>
      <div class="ident">
        <b id="name"></b>
        <span class="muted small" id="login"></span>
      </div>
      <button id="logout" class="ghost">退出</button>
    </div>

    <div id="forms">
      <div class="tabs">
        <button class="tab on" data-tab="email">邮箱登录</button>
        <button class="tab" data-tab="github">GitHub</button>
      </div>

      <section class="pane" data-pane="email">
        <div class="modes">
          <button class="mode on" data-mode="login">登录</button>
          <button class="mode" data-mode="register">注册</button>
        </div>
        <form id="emailForm" autocomplete="on">
          <label>
            邮箱
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" />
          </label>
          <label>
            密码
            <input type="password" id="password" required autocomplete="current-password" placeholder="至少 8 位" />
          </label>
          <label id="nameWrap" hidden>
            昵称 <span class="muted">（选填，榜上和墙上显示这个）</span>
            <input type="text" id="nickname" maxlength="16" autocomplete="nickname" placeholder="不填就用邮箱前缀" />
          </label>
          <button class="btn primary" type="submit" id="submitBtn">登录</button>
        </form>
        <p class="muted small">
          密码用 PBKDF2 加盐存哈希，服务器也不保存明文。忘记密码目前只能重注册。
        </p>
      </section>

      <section class="pane" data-pane="github" hidden>
        <a class="btn" id="gologin" href="/api/auth/github/start?next=/leaderboard/">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          用 GitHub 登录
        </a>
        <p class="muted small">只申请 <code>read:user</code> 权限，拿不到你的仓库，也不能替你发东西。</p>
      </section>

      <p class="err" id="err" hidden></p>
    </div>
  </div>

  <p class="muted small" style="margin-top:18px">不登录也能玩、也能上榜，只是榜上显示打码后的 IP 和地区。</p>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const next = params.get('next') && params.get('next')!.startsWith('/') ? params.get('next')! : '/leaderboard/';

  const $who = document.getElementById('who')!;
  const $forms = document.getElementById('forms')!;
  const $err = document.getElementById('err')!;
  const $badge = document.getElementById('badge')!;
  const $avatar = document.getElementById('avatar')!;
  const $name = document.getElementById('name')!;
  const $login = document.getElementById('login')!;
  const $form = document.getElementById('emailForm') as HTMLFormElement;
  const $email = document.getElementById('email') as HTMLInputElement;
  const $password = document.getElementById('password') as HTMLInputElement;
  const $nickname = document.getElementById('nickname') as HTMLInputElement;
  const $nameWrap = document.getElementById('nameWrap')!;
  const $submit = document.getElementById('submitBtn') as HTMLButtonElement;

  let mode: 'login' | 'register' = 'login';

  const showErr = (msg: string) => {
    $err.hidden = !msg;
    $err.textContent = msg;
  };

  if (params.get('error')) showErr(params.get('error')!);
  document.getElementById('gologin')!.setAttribute('href', '/api/auth/github/start?next=' + encodeURIComponent(next));

  // 已登录就只显示账号卡片
  fetch('/api/me', { headers: { accept: 'application/json' } })
    .then((r) => r.json())
    .then((d) => {
      // GitHub 登录没配好就先把那个 tab 收起来，别让人点进去吃 500
      if (d && d.configured === false) {
        const tab = document.querySelector<HTMLElement>('.tab[data-tab="github"]');
        const pane = document.querySelector<HTMLElement>('.pane[data-pane="github"]');
        if (tab) tab.hidden = true;
        if (pane) pane.hidden = true;
      }
      if (!d?.user) {
        $forms.hidden = false;
        return;
      }
      const u = d.user;
      $who.hidden = false;
      $forms.hidden = true;
      $badge.textContent = u.provider === 'github' ? 'GitHub' : '邮箱';
      $badge.dataset.p = u.provider;
      $name.textContent = u.display || u.login;
      $login.textContent = u.provider === 'github' ? '@' + u.login : u.login;
      if (u.avatar) {
        $avatar.textContent = '';
        const img = document.createElement('img');
        img.src = u.avatar;
        img.alt = '';
        img.width = 40;
        img.height = 40;
        img.style.borderRadius = '50%';
        $avatar.appendChild(img);
      } else {
        $avatar.textContent = (u.display || u.login).slice(0, 1).toUpperCase();
      }
    })
    .catch(() => ($forms.hidden = false));

  document.getElementById('logout')!.addEventListener('click', async () => {
    await fetch('/api/logout', { method: 'POST' });
    location.href = '/';
  });

  // 顶部两个 tab
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach((t) => {
    t.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach((x) => x.classList.toggle('on', x === t));
      document
        .querySelectorAll<HTMLElement>('.pane')
        .forEach((p) => (p.hidden = p.dataset.pane !== t.dataset.tab));
    });
  });

  // 登录 / 注册切换
  document.querySelectorAll<HTMLButtonElement>('.mode').forEach((m) => {
    m.addEventListener('click', () => {
      mode = m.dataset.mode === 'register' ? 'register' : 'login';
      document.querySelectorAll('.mode').forEach((x) => x.classList.toggle('on', x === m));
      $nameWrap.hidden = mode === 'login';
      $submit.textContent = mode === 'login' ? '登录' : '注册并登录';
      $password.autocomplete = mode === 'login' ? 'current-password' : 'new-password';
      showErr('');
    });
  });

  $form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    showErr('');
    $submit.disabled = true;
    const label = $submit.textContent;
    $submit.textContent = '请稍等…';
    try {
      const url = mode === 'login' ? '/api/auth/email/login' : '/api/auth/email/register';
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email: $email.value.trim(),
          password: $password.value,
          name: mode === 'register' ? $nickname.value.trim() : undefined,
        }),
      });
      const d = await res.json();
      if (!res.ok) throw new Error(d?.error || '失败了');
      location.href = next;
    } catch (e: any) {
      showErr(e?.message || '失败了');
      $submit.disabled = false;
      $submit.textContent = label;
    }
  });
</script>

<style>
  .card {
    margin-top: 18px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .badge {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .badge[data-p='github'] {
    color: var(--fg);
    border-color: var(--accent);
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--fg);
    font-weight: 600;
  }
  .ident {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .who .ghost {
    margin-left: auto;
  }
  .tabs,
  .modes {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .tab,
  .mode {
    font: inherit;
    font-size: 14px;
    padding: 7px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .tab.on,
  .mode.on {
    color: var(--fg);
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .modes {
    margin-bottom: 14px;
  }
  .mode {
    font-size: 13px;
    padding: 4px 12px;
  }
  form {
    display: grid;
    gap: 14px;
  }
  label {
    display: grid;
    gap: 6px;
    font-size: 14px;
  }
  input {
    font: inherit;
    font-size: 15px;
    padding: 10px 12px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
  }
  input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 10px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    font-size: 15px;
    border: 0;
    cursor: pointer;
    width: fit-content;
  }
  .btn.primary {
    width: 100%;
    margin-top: 4px;
  }
  .btn:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .ghost {
    font: inherit;
    font-size: 14px;
    padding: 7px 14px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .small {
    font-size: 13px;
  }
  code {
    background: var(--bg);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12px;
  }
  .err {
    margin-top: 14px;
    color: #d0554a;
    font-size: 14px;
  }
</style>
