---
import Base from '../../layouts/Base.astro';
---
<Base title="登录">
  <h1>登录</h1>
  <p class="muted">用 GitHub 账号登录，之后在排行榜上显示你的头像和用户名，而不是一串 IP。</p>

  <div class="card" id="card">
    <div class="who" id="who" hidden>
      <img id="avatar" alt="" width="48" height="48" />
      <div>
        <b id="login"></b>
        <p class="muted" id="adm" hidden>管理员</p>
      </div>
      <button id="logout" class="ghost">退出</button>
    </div>

    <div id="anon" hidden>
      <a class="btn" id="gologin" href="/api/auth/github/start?next=/leaderboard/">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        用 GitHub 登录
      </a>
      <p class="muted small" id="hint">
        只申请 <code>read:user</code> 权限，拿不到你的仓库，也不会替你发东西。
      </p>
    </div>

    <p class="err" id="err" hidden></p>
  </div>

  <p class="muted small" style="margin-top:18px">
    不登录也能玩、也能上榜，只是榜上显示打码后的 IP 和地区。
  </p>
</Base>

<script>
  const $card = document.getElementById('card')!;
  const $who = document.getElementById('who')!;
  const $anon = document.getElementById('anon')!;
  const $err = document.getElementById('err')!;
  const $login = document.getElementById('login')!;
  const $avatar = document.getElementById('avatar') as HTMLImageElement;
  const $adm = document.getElementById('adm')!;

  // 从 ?next= 带回原来的页面
  const params = new URLSearchParams(location.search);
  const err = params.get('error');
  if (err) {
    $err.hidden = false;
    $err.textContent = err;
  }

  const next = params.get('next') || '/leaderboard/';
  const go = document.getElementById('gologin')!;
  go.setAttribute('href', '/api/auth/github/start?next=' + encodeURIComponent(next));

  fetch('/api/me', { headers: { accept: 'application/json' } })
    .then((r) => r.json())
    .then((d) => {
      if (d && d.user) {
        $who.hidden = false;
        $anon.hidden = true;
        $login.textContent = d.user.login;
        if (d.user.name) $login.textContent = d.user.name + ' · @' + d.user.login;
        $adm.hidden = !d.user.admin;
        if (d.user.avatar) $avatar.src = d.user.avatar;
        (window as any).__mfhryUser = d.user;
      } else {
        $who.hidden = true;
        $anon.hidden = false;
      }
    })
    .catch(() => {
      $anon.hidden = false;
    });

  document.getElementById('logout')!.addEventListener('click', async () => {
    await fetch('/api/logout', { method: 'POST' });
    location.href = '/';
  });
</script>

<style>
  .card {
    margin-top: 18px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .who img {
    border-radius: 50%;
    background: var(--bg);
  }
  .who b {
    font-size: 16px;
  }
  .who .ghost {
    margin-left: auto;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    font-size: 15px;
  }
  .btn:hover {
    opacity: 0.88;
  }
  .ghost {
    font: inherit;
    font-size: 14px;
    padding: 7px 14px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .small {
    font-size: 13px;
    margin-top: 10px;
  }
  code {
    background: var(--bg);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12px;
  }
  .err {
    margin-top: 14px;
    color: #d0554a;
    font-size: 14px;
  }
</style>
