---
import Base from '../layouts/Base.astro';
---
<Base title="投稿">
  <h1>投稿</h1>
  <p class="muted">投一篇短文 / 想法，或贴一条 X（推特）链接自动生成推文卡片。直接公开，可被转贴、评论。每 IP 每小时 3 条。</p>

  <div class="composer">
    <input id="nick" class="key" type="text" maxlength="24" placeholder="昵称（可选，留空匿名）" />
    <input id="title" class="key" type="text" maxlength="80" placeholder="标题（可选）" />
    <textarea id="body" maxlength="2000" placeholder="内容…（最多 2000 字）"></textarea>
    <input id="x" class="key" type="url" placeholder="X / 推特链接（可选，贴了会抓成推文卡片）" />
    <div class="crow">
      <input id="tag" class="key" type="text" maxlength="16" placeholder="标签（可选）" />
      <input id="link" class="key" type="url" maxlength="300" placeholder="普通链接（可选）" />
      <button id="send" class="send">投稿</button>
    </div>
    <div id="status" class="muted"></div>
  </div>

  <div id="list"></div>
  <p class="muted" id="empty" hidden>还没有投稿，来投第一篇。</p>

  <style>
    .composer{display:flex;flex-direction:column;gap:10px;margin:16px 0 22px;padding:16px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.09);border-radius:14px}
    .key{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff;border-radius:10px;padding:10px 12px;font-size:14px;width:100%;box-sizing:border-box}
    .key::placeholder{color:rgba(255,255,255,.35)}
    .key:focus{outline:none;border-color:rgba(255,150,90,.5)}
    textarea.key{min-height:110px;resize:vertical;line-height:1.6}
    .crow{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
    .crow .key{flex:1;min-width:150px}
    .send{padding:10px 22px;border:0;border-radius:10px;background:linear-gradient(135deg,#ff7a45,#ff5e3a);color:#fff;font-size:14px;cursor:pointer;white-space:nowrap}
    .send:hover{filter:brightness(1.1)}
    .send:disabled{opacity:.5;cursor:default}
    .muted{color:rgba(255,255,255,.45);font-size:13px}
    #status{min-height:18px;margin-top:2px}
    .sub{padding:14px 16px;margin:10px 0;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:14px}
    .sub-head{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
    .sub-head b{font-size:15px;color:#fff}
    .tag{padding:1px 8px;border-radius:999px;background:rgba(255,255,255,.08);color:#ffb98a;font-size:11.5px}
    .meta{color:rgba(255,255,255,.4);font-size:12px}
    .sub-body{margin:9px 0;font-size:14px;line-height:1.7;color:rgba(255,255,255,.85);white-space:pre-wrap;word-break:break-word}
    .sub-link{display:inline-block;font-size:12.5px;color:#7ab8ff;word-break:break-all;margin-bottom:8px}
    .acts{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:6px}
    .act{border:0;border-radius:999px;padding:4px 12px;background:rgba(255,255,255,.08);color:rgba(255,255,255,.6);font-size:12px;cursor:pointer}
    .act:hover{background:rgba(255,255,255,.16);color:#fff}
    .act.on{color:#ff9a6a}
    /* X 推文卡片 */
    .tw{margin:10px 0;border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:12px 14px;background:rgba(0,0,0,.22)}
    .tw-h{display:flex;align-items:flex-start;gap:10px;flex-wrap:nowrap}
    .tw-av{width:38px;height:38px;border-radius:50%;flex:0 0 38px;object-fit:cover;background:rgba(255,255,255,.1)}
    .tw-av-0{display:flex;align-items:center;justify-content:center;font-size:16px;color:#fff;font-weight:600}
    .tw-id{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap;min-width:0}
    .tw-id b{font-size:14px;color:#fff;display:inline-flex;align-items:center;gap:4px}
    .tw-id b::after{content:"✓";display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;background:#1d9bf0;color:#fff;font-size:9px;font-weight:700}
    .tw-handle{font-size:12.5px;color:rgba(255,255,255,.45)}
    .tw-date{font-size:12px;color:rgba(255,255,255,.34)}
    .tw-replyto{font-size:12px;color:rgba(255,255,255,.4);margin:5px 0 0 48px}
    .tw-tr{display:flex;align-items:center;gap:8px;margin:8px 0 2px;font-size:12px}
    .tw-tr-label{color:rgba(255,255,255,.42)}
    .tw-tr-btn{border:0;border-radius:7px;padding:2px 9px;background:rgba(29,155,240,.16);color:#5bb4f0;font-size:11.5px;cursor:pointer}
    .tw-tr-btn:hover{background:rgba(29,155,240,.28);color:#8ccbf5}
    .tw-tr-btn:disabled{opacity:.6;cursor:default}
    .tw-txt{margin:8px 0 6px;font-size:14px;line-height:1.65;color:rgba(255,255,255,.88);white-space:pre-wrap;word-break:break-word}
    .tw-txt[hidden]{display:none}
    .tw-trans{border-left:2px solid rgba(29,155,240,.45);padding-left:9px;color:rgba(255,255,255,.92)}
    .tw-imgs{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
    .tw-imgs img{max-width:100%;max-height:220px;border-radius:10px;border:1px solid rgba(255,255,255,.08)}
    .tw-stats{display:flex;gap:14px;margin-top:9px;padding-top:8px;border-top:1px solid rgba(255,255,255,.07);font-size:12px;color:rgba(255,255,255,.45)}
    .tw-stats span{white-space:nowrap}
    .tw-replies{margin-top:8px}
    .tw-replies-h{font-size:11.5px;letter-spacing:.08em;color:rgba(255,255,255,.36);margin-bottom:5px}
    .tw-foot{margin-top:8px;font-size:12px}
    .tw-foot a{color:#7ab8ff;text-decoration:none}
    /* 转贴条目 */
    .rp{display:flex;align-items:center;gap:7px;padding:8px 12px;font-size:12.5px;color:rgba(255,255,255,.5);background:rgba(255,255,255,.02);border-left:2px solid rgba(255,150,90,.4);border-radius:0 8px 8px 0;margin:6px 0}
    .rp b{color:rgba(255,255,255,.8);font-weight:600}
    /* 评论 */
    .cmts{margin-top:10px;padding-top:10px;border-top:1px dashed rgba(255,255,255,.1);display:none}
    .cmts.on{display:block}
    .cmt{display:flex;gap:8px;padding:6px 0;font-size:13px;line-height:1.6}
    .cmt b{color:rgba(255,255,255,.85);flex:0 0 auto}
    .cmt .t{color:rgba(255,255,255,.32);font-size:11px;flex:0 0 auto}
    .cmt .b{color:rgba(255,255,255,.72);white-space:pre-wrap;word-break:break-word}
    .cmt-form{display:flex;gap:8px;margin-top:8px}
    .cmt-form input{flex:1;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff;border-radius:9px;padding:7px 10px;font-size:13px}
    .cmt-form button{border:0;border-radius:9px;padding:7px 14px;background:rgba(255,150,90,.85);color:#fff;font-size:13px;cursor:pointer}
    .cmt-empty{font-size:12.5px;color:rgba(255,255,255,.35);padding:6px 0}
  </style>

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const nickEl = $('nick'), titleEl = $('title'), bodyEl = $('body'), xEl = $('x'),
          tagEl = $('tag'), linkEl = $('link'), sendEl = $('send'), statusEl = $('status'),
          listEl = $('list'), emptyEl = $('empty');
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function tm(t) {
      if (!t) return '';
      const d = new Date(String(t).replace(' ', 'T') + 'Z');
      if (isNaN(d)) return '';
      const p = (x) => String(x).padStart(2, '0');
      const now = new Date();
      return (d.getFullYear() === now.getFullYear() ? p(d.getMonth() + 1) + '/' + p(d.getDate()) : d.getFullYear() + '/' + p(d.getMonth() + 1) + '/' + p(d.getDate())) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }

    function quoteCard(q) {
      if (!q || (!q.text && !q.author)) return '';
      return '<div style="margin-top:8px;padding:9px 11px;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:rgba(255,255,255,.03)">' +
        '<div style="font-size:12.5px;color:rgba(255,255,255,.66)"><b>' + esc(q.author || 'X 用户') + '</b>' +
        (q.handle ? ' <span style="color:rgba(255,255,255,.4)">@' + esc(q.handle) + '</span>' : '') +
        (q.date ? ' <span style="color:rgba(255,255,255,.3)">· ' + esc(q.date) + '</span>' : '') + '</div>' +
        (q.text ? '<div style="margin-top:4px;font-size:13px;line-height:1.6;color:rgba(255,255,255,.78);white-space:pre-wrap">' + esc(q.text) + '</div>' : '') +
        '</div>';
    }

    function fmtNum(n) {
      n = Number(n) || 0;
      if (n >= 1e8) return (n / 1e8).toFixed(1).replace(/\.0$/, '') + ' 亿';
      if (n >= 1e4) return (n / 1e4).toFixed(1).replace(/\.0$/, '') + ' 万';
      if (n >= 1e3) return (n / 1e3).toFixed(1).replace(/\.0$/, '') + 'k';
      return String(n);
    }
    const LANG_NAME = { en: '英语', ja: '日语', zh: '中文', ko: '韩语', ru: '俄语', fr: '法语', de: '德语', es: '西班牙语' };

    function tweetCard(tw) {
      if (!tw) return '';
      const pid = tw.id || '';
      if (tw.error && !tw.text) {
        return '<div class="tw"><div class="tw-h"><b>X 帖子</b></div>' +
          '<div class="tw-txt" style="color:rgba(255,255,255,.45)">推文抓取失败，点开原链接查看</div>' +
          '<div class="tw-foot"><a href="' + esc(tw.url) + '" target="_blank" rel="noreferrer noopener">' + esc(tw.url) + '</a></div></div>';
      }
      const imgs = (tw.photos || []).map((p) => '<img src="data:' + p.mime + ';base64,' + p.b64 + '" loading="lazy" alt="">').join('');
      const langName = LANG_NAME[tw.lang] || tw.lang || '英语';
      const needTr = tw.text && (tw.lang && tw.lang !== 'zh');
      const st = tw.stats || {};
      const statsBar = (st.likes || st.replies || st.retweets || st.quotes)
        ? '<div class="tw-stats">' +
            (st.replies ? '<span>💬 ' + fmtNum(st.replies) + '</span>' : '') +
            (st.retweets ? '<span>🔁 ' + fmtNum(st.retweets) + '</span>' : '') +
            (st.likes ? '<span>♥ ' + fmtNum(st.likes) + '</span>' : '') +
            (st.quotes ? '<span>📌 ' + fmtNum(st.quotes) + '</span>' : '') +
          '</div>' : '';
      const replyTag = tw.replyTo && tw.replyTo.handle ? '<div class="tw-replyto">回复 @' + esc(tw.replyTo.handle) + '</div>' : '';
      let replies = '';
      if (tw.replies && tw.replies.length) {
        replies = '<div class="tw-replies"><div class="tw-replies-h">原帖评论</div>' + tw.replies.map(quoteCard).join('') + '</div>';
      }
      const avatarHtml = tw.avatar
        ? '<img class="tw-av" src="' + esc(tw.avatar) + '" referrerpolicy="no-referrer" loading="lazy" alt="">'
        : '<div class="tw-av tw-av-0">' + esc((tw.author || '?')[0] || '?') + '</div>';
      return '<div class="tw" data-twid="' + esc(pid) + '">' +
        '<div class="tw-h">' + avatarHtml +
          '<div class="tw-id"><b>' + esc(tw.author || 'X 用户') + '</b>' +
          (tw.handle ? '<span class="tw-handle">@' + esc(tw.handle) + '</span>' : '') +
          (tw.date ? '<span class="tw-date">' + esc(tw.date) + '</span>' : '') + '</div>' +
        '</div>' +
        replyTag +
        (needTr ? '<div class="tw-tr"><span class="tw-tr-label">翻译自 ' + esc(langName) + '</span>' +
            '<button class="tw-tr-btn" data-twid="' + esc(pid) + '" data-lang="' + esc(tw.lang) + '">翻译</button></div>' : '') +
        (tw.text ? '<div class="tw-txt" data-orig="1">' + esc(tw.text) + '</div>' : '') +
        (tw.text ? '<div class="tw-txt tw-trans" hidden></div>' : '') +
        (imgs ? '<div class="tw-imgs">' + imgs + '</div>' : '') +
        statsBar +
        quoteCard(tw.quote) + replies +
        '<div class="tw-foot"><a href="' + esc(tw.url) + '" target="_blank" rel="noreferrer noopener">在 X 查看原帖 →</a></div></div>';
    }

    function card(s) {
      const geo = [s.country, s.region, s.city].filter(Boolean).join(' · ');
      const isX = s.tweet || /(?:x\.com|twitter\.com)/i.test(s.link || '');
      return '<div class="sub" data-id="' + s.id + '">' +
        '<div class="sub-head"><b>' + esc(s.title || '(无标题)') + '</b>' +
        (s.tag ? '<span class="tag">' + esc(s.tag) + '</span>' : '') +
        '<span class="meta">' + esc(s.author) + (geo ? ' · ' + esc(geo) : '') + ' · ' + tm(s.created_at) + '</span></div>' +
        (s.body ? '<div class="sub-body">' + esc(s.body) + '</div>' : '') +
        (s.tweet ? tweetCard(s.tweet) : '') +
        (s.link && !isX ? '<a class="sub-link" href="' + esc(s.link) + '" target="_blank" rel="noreferrer noopener">' + esc(s.link) + '</a>' : '') +
        '<div class="acts">' +
          '<button class="act like" data-id="' + s.id + '">♥ <span>' + (s.likes || 0) + '</span></button>' +
          '<button class="act rp-btn" data-id="' + s.id + '">🔁 <span>' + (s.reposts || 0) + '</span> 转贴</button>' +
          '<button class="act cmt-btn" data-id="' + s.id + '">💬 <span>' + (s.commentCount || 0) + '</span> 评论</button>' +
        '</div>' +
        '<div class="cmts" id="cmts-' + s.id + '"></div></div>';
    }

    function rpRow(r) {
      return '<div class="rp"><span>🔁</span><b>' + esc(r.reposter) + '</b><span>转贴了</span><b>' + esc(r.postAuthor) + '</b>' +
        '<span>的「' + esc(r.title || (r.body || '').slice(0, 24) || '投稿') + '」</span><span>· ' + tm(r.at) + '</span></div>';
    }

    async function load() {
      try {
        const r = await fetch('/api/submit?limit=50', { cache: 'no-store' });
        const d = await r.json();
        if (!d.ok) return;
        const items = d.items || [];
        let html = '';
        // 顶部最新转贴动态（最多 5 条）
        (d.reposts || []).slice(0, 5).forEach((rp) => { html += rpRow(rp); });
        html += items.map(card).join('');
        listEl.innerHTML = html;
        emptyEl.hidden = items.length > 0;
      } catch (e) {}
    }

    async function loadComments(postId, box) {
      box.innerHTML = '<div class="cmt-empty">加载评论…</div>';
      try {
        const r = await fetch('/api/submit?action=comments&id=' + postId, { cache: 'no-store' });
        const d = await r.json();
        let html = '';
        if (d.ok && d.items && d.items.length) {
          html += d.items.map((c) =>
            '<div class="cmt"><b>' + esc(c.author) + '</b><span class="t">' + tm(c.created_at) + '</span>' +
            '<span class="b">' + esc(c.body) + '</span></div>').join('');
        } else html += '<div class="cmt-empty">还没有评论，说点什么。</div>';
        html += '<div class="cmt-form"><input maxlength="24" placeholder="昵称（可选）" class="c-nick" data-id="' + postId + '">' +
          '<input maxlength="500" placeholder="写评论…" class="c-body" data-id="' + postId + '">' +
          '<button class="c-send" data-id="' + postId + '">发表</button></div>';
        box.innerHTML = html;
      } catch (e) { box.innerHTML = '<div class="cmt-empty">评论加载失败</div>'; }
    }

    sendEl.onclick = async () => {
      const body = bodyEl.value.trim();
      const x = xEl.value.trim();
      if (!body && !x) { statusEl.textContent = '内容不能为空（或贴一条 X 链接）'; return; }
      statusEl.textContent = '投稿中…';
      sendEl.disabled = true;
      try {
        const r = await fetch('/api/submit', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title: titleEl.value, body, author: nickEl.value, tag: tagEl.value, link: linkEl.value, x }),
        });
        const d = await r.json();
        if (d.ok) {
          statusEl.textContent = d.tweet ? '已发布 ✓（推文已抓成卡片）' : '已发布 ✓';
          bodyEl.value = ''; titleEl.value = ''; tagEl.value = ''; linkEl.value = ''; xEl.value = '';
          load();
        } else statusEl.textContent = d.error || '投稿失败';
      } catch (e) { statusEl.textContent = '网络错误'; }
      finally { sendEl.disabled = false; }
    };

    listEl.addEventListener('click', async (e) => {
      const trBtn = e.target.closest('.tw-tr-btn');
      if (trBtn) {
        const twBox = trBtn.closest('.tw');
        const orig = twBox.querySelector('.tw-txt[data-orig]');
        const trans = twBox.querySelector('.tw-trans');
        if (!orig || !trans) return;
        const showing = !trans.hidden;
        if (showing) { trans.hidden = true; orig.hidden = false; trBtn.textContent = '翻译'; return; }
        if (trans.dataset.loaded) { trans.hidden = false; orig.hidden = true; trBtn.textContent = '显示原文'; return; }
        trBtn.disabled = true; trBtn.textContent = '翻译中…';
        try {
          const text = orig.textContent || '';
          let done = false;
          for (let attempt = 0; attempt < 3 && !done; attempt++) {
            const r = await fetch('/api/translate?text=' + encodeURIComponent(text) + '&tl=zh-CN');
            const d = await r.json().catch(() => ({}));
            if (d && d.text) { trans.textContent = d.text; trans.dataset.loaded = '1'; trans.hidden = false; orig.hidden = true; trBtn.textContent = '显示原文'; done = true; }
            else await new Promise((res) => setTimeout(res, 900));
          }
          if (!done) { trBtn.textContent = '翻译失败，再点一次'; }
        } catch (err) { trBtn.textContent = '翻译失败'; }
        finally { trBtn.disabled = false; }
        return;
      }
      const likeBtn = e.target.closest('.like');
      if (likeBtn) {
        const span = likeBtn.querySelector('span');
        const cur = Number(span.textContent) || 0;
        span.textContent = cur + 1;
        try { await fetch('/api/submit?action=like&id=' + likeBtn.dataset.id); } catch (err) { span.textContent = cur; }
        return;
      }
      const rpBtn = e.target.closest('.rp-btn');
      if (rpBtn) {
        rpBtn.disabled = true;
        const author = prompt('转贴用昵称（可留空）') || '';
        const span = rpBtn.querySelector('span');
        const cur = Number(span.textContent) || 0;
        try {
          const r = await fetch('/api/submit?action=repost&id=' + rpBtn.dataset.id + '&author=' + encodeURIComponent(author));
          const d = await r.json();
          if (d.ok) { span.textContent = cur + 1; load(); }
          else { alert(d.error || '转贴失败'); rpBtn.disabled = false; }
        } catch (err) { rpBtn.disabled = false; }
        return;
      }
      const cmtBtn = e.target.closest('.cmt-btn');
      if (cmtBtn) {
        const id = cmtBtn.dataset.id;
        const box = document.getElementById('cmts-' + id);
        if (!box) return;
        const open = box.classList.toggle('on');
        if (open) loadComments(id, box);
        return;
      }
      const cSend = e.target.closest('.c-send');
      if (cSend) {
        const id = cSend.dataset.id;
        const box = document.getElementById('cmts-' + id);
        const nick = box.querySelector('.c-nick').value.trim();
        const bodyIn = box.querySelector('.c-body');
        const body = bodyIn.value.trim();
        if (!body) return;
        cSend.disabled = true;
        try {
          const r = await fetch('/api/submit?action=comment', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: Number(id), author: nick, body }),
          });
          const d = await r.json();
          if (d.ok) {
            const counter = box.closest('.sub').querySelector('.cmt-btn span');
            counter.textContent = (Number(counter.textContent) || 0) + 1;
            loadComments(id, box);
          } else alert(d.error || '评论失败');
        } catch (err) { alert('网络错误'); }
        finally { cSend.disabled = false; }
      }
    });

    load();
  </script>
</Base>
