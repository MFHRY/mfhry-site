---
import Base from '../../layouts/Base.astro';
---
<Base title="排行榜">
  <h1>小游戏排行榜</h1>
  <p class="muted">
    每个 IP 只留一条最好成绩，右边是你的名次。地区由 Cloudflare 边缘节点判断，可能不太准。
    <span id="loginHint">登录后显示 GitHub 头像和用户名，而不是 IP。</span>
  </p>

  <div class="tabbar">
    <div class="tabs" id="tabs"></div>
    <button class="refresh" id="refresh" title="刷新榜单">↻ 刷新</button>
  </div>

  <div class="myrow" id="me" hidden></div>

  <div class="tablewrap">
    <table class="board" id="board">
      <thead>
        <tr>
          <th class="rank">#</th>
          <th>来自</th>
          <th class="ipcol">IP</th>
          <th class="score">成绩</th>
          <th class="when">时间</th>
        </tr>
      </thead>
      <tbody id="rows">
        <tr><td colspan="5" class="empty">加载中…</td></tr>
      </tbody>
    </table>
  </div>

  <p class="muted small">
    成绩由浏览器提交，只能防手滑、防不了改代码。IP 的最后一段已经打码。 ·
    <a href="/games/">← 回小游戏</a>
  </p>
</Base>

<script>
  type GhUser = {
    provider: string;
    login: string;
    name: string | null;
    avatar: string | null;
    display: string;
    verified?: boolean;
  };

  type Entry = {
    id: number;
    rank: number;
    name: string | null;
    score: number;
    ip: string;
    user: GhUser | null;
    flag: string;
    country: string | null;
    countryName: string;
    region: string | null;
    regionName: string;
    city: string | null;
    at: string | null;
  };

  const GAMES: Array<[string, string]> = [
    ['tetris', '俄罗斯方块'],
    ['2048', '2048'],
    ['snake', '贪吃蛇'],
    ['flappy', '像素鸟'],
    ['invaders', '太空侵略者'],
    ['breakout', '打砖块'],
    ['gold-miner', '黄金矿工'],
    ['minesweeper', '扫雷'],
    ['memory', '记忆翻牌'],
    ['puzzle15', '数字华容道'],
  ];

  const $tabs = document.getElementById('tabs')!;
  const $rows = document.getElementById('rows')!;
  const $me = document.getElementById('me')!;
  const $refresh = document.getElementById('refresh') as HTMLButtonElement;

  // 记住上一次交成绩的游戏，打开榜单先看这个（否则你刚玩的游戏榜是空的，看着像没上榜）
  const LAST_KEY = 'mfhry_last_game';
  let lastGame = '';
  try {
    lastGame = localStorage.getItem(LAST_KEY) || '';
  } catch {
    /* 隐私模式下 localStorage 会抛 */
  }

  let current = (location.hash || '').slice(1) || lastGame || 'tetris';
  if (!GAMES.some(([slug]) => slug === current)) current = 'tetris';
  let autoTimer: ReturnType<typeof setInterval> | undefined;

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  const when = (iso: string | null) => {
    if (!iso) return '';
    const d = new Date(iso.replace(' ', 'T') + 'Z');
    if (Number.isNaN(d.getTime())) return '';
    const mins = Math.floor((Date.now() - d.getTime()) / 60000);
    if (mins < 1) return '刚刚';
    if (mins < 60) return mins + ' 分钟前';
    if (mins < 1440) return Math.floor(mins / 60) + ' 小时前';
    return `${d.getMonth() + 1}/${d.getDate()}`;
  };

  function paintTabs() {
    $tabs.innerHTML = '';
    for (const [slug, label] of GAMES) {
      const b = document.createElement('button');
      b.textContent = label + (slug === lastGame ? ' ●' : '');
      b.className = slug === current ? 'tab on' : 'tab';
      b.title = slug === lastGame ? '你最近玩过的' : '';
      b.onclick = () => {
        current = slug;
        history.replaceState(null, '', '#' + slug);
        paintTabs();
        load();
      };
      $tabs.appendChild(b);
    }
  }

  function rowHtml(e: Entry, unit: string, mine: boolean, admin = false) {
    const where = [e.flag, e.countryName, e.regionName].filter(Boolean).join(' ');
    const medal = e.rank === 1 ? '🥇' : e.rank === 2 ? '🥈' : e.rank === 3 ? '🥉' : String(e.rank);
    const who = e.user
      ? e.user.provider === 'github'
        ? `<span class="ghwho">${
            e.user.avatar
              ? `<img class="av" src="${esc(e.user.avatar)}" alt="" width="18" height="18" loading="lazy" />`
              : ''
          }<a class="gh" href="https://github.com/${esc(e.user.login)}" target="_blank" rel="noopener">${esc(
            e.user.login
          )}</a></span>`
        : `<span class="ghwho"><span class="ini">${esc(
            (e.user.display || e.user.login).slice(0, 1).toUpperCase()
          )}</span><span class="em">${esc(e.user.display || e.user.login)}</span>${
            e.user.verified ? '<span class="vfy" title="邮箱已验证">✓</span>' : ''
          }</span>`
      : `${esc(e.ip)}${e.name ? ` <em class="nm">${esc(e.name)}</em>` : ''}`;
    return `<tr class="${mine ? 'mine' : ''}${e.rank <= 3 ? ' top' : ''}">
      <td class="rank">${medal}</td>
      <td class="where" title="${esc(where)}">${esc(where)}${mine ? ' <b class="you">你</b>' : ''}</td>
      <td class="ipcol">${who}${
        admin ? ` <button class="del" data-id="${e.id}" title="删掉这条">✕</button>` : ''
      }</td>
      <td class="score">${e.score}<i>${esc(unit || '')}</i></td>
      <td class="when">${esc(when(e.at))}</td>
    </tr>`;
  }

  async function load(silent = false) {
    if (!silent) {
      $rows.innerHTML = '<tr><td colspan="5" class="empty">加载中…</td></tr>';
      $me.hidden = true;
    }
    try {
      // 加时间戳：避免任何一层缓存把旧榜单喂回来
      const url = `/api/score?game=${encodeURIComponent(current)}&limit=20&t=${Date.now()}`;
      const res = await fetch(url, { headers: { accept: 'application/json' }, cache: 'no-store' });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || '加载失败');
      render(data);
      $refresh.textContent = '↻ 刷新';
    } catch (err: any) {
      $rows.innerHTML = `<tr><td colspan="5" class="empty">${esc(err?.message || '加载失败')}</td></tr>`;
      $refresh.textContent = '↻ 重试';
    }
  }

  function render(data: any) {
    const entries: Entry[] = data.entries || [];
    const unit = data.unit || '';
    const myLogin = data.user?.login || '';
    const admin = !!data.user?.admin;

    // 登录了就按账号认自己，没登录才按（打码后的）IP 认
    const isMine = (e: Entry) =>
      myLogin ? e.user?.login === myLogin : !!data.me?.ip && e.ip === data.me.ip;
    const mineInList = entries.some(isMine);

    let html = '';
    if (!entries.length) {
      html = '<tr><td colspan="5" class="empty">还没有人上榜，去玩一局吧</td></tr>';
    } else {
      html = entries.map((e) => rowHtml(e, unit, isMine(e), admin)).join('');
      // 名次掉出前 20 时，把你自己那行也贴出来，不然看着就像「没上榜」
      if (data.me && !mineInList) {
        html += '<tr class="gap"><td colspan="5">⋯ 你的名次在前 20 之外 ⋯</td></tr>';
        html += rowHtml(data.me, unit, true, admin);
      }
    }
    $rows.innerHTML = html;

    if (data.me) {
      $me.hidden = false;
      const outside = mineInList ? '' : '（不在前 20，已单列在下面）';
      const who = myLogin ? `以 <b>${esc(myLogin)}</b> 的身份` : '这个 IP ';
      $me.innerHTML = `${who}在 <b>${esc(data.label)}</b> 排第 <b>${data.me.rank}</b> 名，成绩 ${
        data.me.score
      }${esc(unit)}，共 ${data.total} 人上榜${outside}`;
    } else if (data.total) {
      $me.hidden = false;
      $me.textContent = `共 ${data.total} 人上榜，${myLogin ? '你' : '这个 IP'} 还没交过成绩`;
    } else {
      $me.hidden = true;
    }

    // 没登录就给个入口
    const $hint = document.getElementById('loginHint');
    if ($hint) {
      if (myLogin) {
        $hint.innerHTML = `已以 <b>${esc(myLogin)}</b> 登录 · <a href="/login/">账号</a>`;
      } else {
        $hint.innerHTML =
          '<a href="/login/?next=' + encodeURIComponent('/leaderboard/#' + current) + '">用 GitHub 登录</a>，榜上就显示头像和用户名，而不是 IP。';
      }
    }

    // 管理员出现删按钮
    if (admin) {
      $rows.querySelectorAll<HTMLButtonElement>('.del').forEach((b) => {
        b.onclick = async (ev) => {
          ev.preventDefault();
          if (!confirm('删掉这一条？')) return;
          await fetch('/api/score?id=' + b.dataset.id, { method: 'DELETE' });
          load();
        };
      });
    }
  }

  $refresh.onclick = () => load();

  // 每 20 秒自己刷一次，别人刚打完也能很快看到
  clearInterval(autoTimer);
  autoTimer = setInterval(() => {
    if (!document.hidden) load(true);
  }, 20000);

  paintTabs();
  load();
</script>

<style>
  .tabbar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 18px 0 14px;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }
  .refresh {
    flex: none;
    font: inherit;
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted);
    cursor: pointer;
  }
  .refresh:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tab {
    font: inherit;
    font-size: 13px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted);
    cursor: pointer;
  }
  .tab:hover {
    color: var(--fg);
  }
  .tab.on {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  .myrow {
    margin: 0 0 14px;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--fg);
    font-size: 14px;
  }
  .tablewrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
  }
  table.board {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .board th,
  .board td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .board thead th {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    background: var(--bg);
  }
  .board tbody tr:last-child td {
    border-bottom: 0;
  }
  .board tr.mine td {
    background: var(--accent-soft);
  }
  .board tr.mine .ipcol {
    color: var(--fg);
  }
  .board .you {
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0 6px;
    margin-left: 4px;
  }
  .board tr.gap td {
    text-align: center;
    color: var(--muted);
    font-size: 12px;
    padding: 6px 12px;
  }
  .board tr.top .rank {
    font-size: 16px;
  }
  .board .rank {
    width: 44px;
    color: var(--muted);
    text-align: right;
  }
  .board .where {
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
  }
  .board .ipcol {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    color: var(--muted);
  }
  .board .ipcol .nm {
    font-style: normal;
    color: var(--fg);
    margin-left: 6px;
    font-family: inherit;
  }
  .board .ghwho {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .board .av {
    border-radius: 50%;
    display: block;
    background: var(--bg);
  }
  .board .gh {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px dotted var(--border);
  }
  .board .gh:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .board .ghwho .ini {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 11px;
    background: var(--accent-soft);
    color: var(--fg);
    flex: none;
  }
  .board .em {
    color: var(--fg);
  }
  .board .vfy {
    font-size: 11px;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 50%;
    width: 15px;
    height: 15px;
    display: inline-grid;
    place-items: center;
    line-height: 1;
  }
  .board .del {
    font: inherit;
    font-size: 12px;
    margin-left: 6px;
    padding: 0 6px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    line-height: 18px;
  }
  .board .del:hover {
    color: #d0554a;
    border-color: #d0554a;
  }
  .board .score {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .board .score i {
    font-style: normal;
    color: var(--muted);
    font-size: 12px;
    margin-left: 2px;
  }
  .board .when {
    color: var(--muted);
    font-size: 12px;
    text-align: right;
  }
  .empty {
    text-align: center;
    color: var(--muted);
    padding: 24px 12px;
  }
  .small {
    font-size: 13px;
    margin-top: 14px;
  }
  @media (max-width: 560px) {
    .board .when,
    .board thead th.when {
      display: none;
    }
    .board .where {
      max-width: 140px;
    }
  }
</style>
