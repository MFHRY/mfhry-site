---
import Base from '../layouts/Base.astro';
---
<Base title="视频">
  <div class="vhead">
    <h1>视频</h1>
    <div class="vacts">
      <button id="uplocal" class="pick" type="button">＋ 本机视频</button>
      <button id="upbtn" class="send" type="button">＋ 上传</button>
    </div>
  </div>
  <p class="muted">点开就看。站内发布、删除需要口令；本机视频只存当前浏览器，不上传服务器。</p>

  <div id="grid" class="vids"></div>
  <p class="muted" id="empty" hidden>还没有视频。</p>

  <!-- 口令 -->
  <div id="gate" class="vmodal" hidden>
    <div class="vbox small">
      <button class="vx" data-close type="button">×</button>
      <h2>输入口令</h2>
      <input id="key" class="key" type="password" placeholder="口令" autocomplete="current-password" />
      <p class="vmsg" id="gmsg"></p>
      <button id="gok" class="send" type="button">确认</button>
    </div>
  </div>

  <!-- 删除口令 -->
  <div id="del" class="vmodal" hidden>
    <div class="vbox small">
      <button class="vx" data-close type="button">×</button>
      <h2>删除视频</h2>
      <p class="muted" id="dname"></p>
      <input id="dkey" class="key" type="password" placeholder="输入口令" autocomplete="current-password" />
      <p class="vmsg" id="dmsg"></p>
      <div class="crow">
        <button id="dok" class="send" type="button">确认删除</button>
        <button id="dcancel" class="pick" type="button">取消</button>
      </div>
    </div>
  </div>

  <!-- 本机视频 -->
  <div id="lcomp" class="vmodal" hidden>
    <div class="vbox">
      <button class="vx" data-close type="button">×</button>
      <h2>添加本机视频</h2>
      <p class="muted">只保存在当前浏览器，不上传服务器；换设备或清理站点数据后不可见。</p>
      <div class="crow">
        <label class="pick lpick"><input id="lf" type="file" accept="video/*" hidden />选择视频文件</label>
        <span class="lfile" id="lfile">未选择</span>
      </div>
      <div id="lprev" class="preview"></div>
      <input id="lt" class="key" type="text" maxlength="120" placeholder="标题（默认用文件名）" />
      <textarea id="ld" maxlength="2000" placeholder="简介（可选，最多 2000 字）"></textarea>
      <p class="vmsg" id="lmsg"></p>
      <div class="crow">
        <button id="lok" class="send" type="button">加入本机</button>
        <button id="lout" class="pick" type="button">退出</button>
      </div>
    </div>
  </div>

  <!-- 上传 -->
  <div id="comp" class="vmodal" hidden>
    <div class="vbox">
      <button class="vx" data-close type="button">×</button>
      <h2>上传视频</h2>
      <div class="crow">
        <label class="pick"><input id="vf" type="file" accept="video/*" hidden />选择本地视频</label>
        <button id="vfrm" class="pick" type="button" hidden>清除</button>
        <span class="muted" id="vfhint">上传到服务器（≤40MB，实验性）；不选文件则用下方外链</span>
      </div>
      <progress id="vprog" max="100" value="0" hidden></progress>
      <input id="t" class="key" type="text" maxlength="120" placeholder="标题（必填）" />
      <input id="u" class="key" type="url" placeholder="或填视频链接：B 站 / 腾讯 / 优酷 / 西瓜 / AcFun / YouTube / mp4 直链" />
      <textarea id="d" maxlength="2000" placeholder="简介（可选，最多 2000 字）"></textarea>
      <div class="crow">
        <label class="pick"><input id="f" type="file" accept="image/jpeg,image/png,image/webp" hidden />封面</label>
        <span class="muted" id="hint">封面可选（不填就用播放图标代替）</span>
      </div>
      <div id="prev" class="preview"></div>
      <p class="vmsg" id="cmsg"></p>
      <div class="crow">
        <button id="cok" class="send" type="button">发布</button>
        <button id="cout" class="pick" type="button">退出</button>
      </div>
    </div>
  </div>

  <!-- 播放 -->
  <div id="play" class="vmodal" hidden>
    <div class="vbox wide">
      <button class="vx" data-close type="button">×</button>
      <h2 id="ptitle"></h2>
      <div id="pbody" class="vplayer"></div>
      <p class="muted" id="pmeta"></p>
    </div>
  </div>

  <style is:global>
    .vacts { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
    .vlocal {
      position: absolute; top: 8px; left: 8px; z-index: 2;
      background: rgba(127, 209, 176, .94); color: #081410;
      font-size: 10.5px; font-weight: 700; letter-spacing: .4px;
      padding: 2px 7px; border-radius: 999px;
    }
    .vid.local { border-color: rgba(127, 209, 176, .42); }
    /* 全站 button 玻璃规则带 position:relative，覆盖了这里的绝对定位；显式压回去 */
    .vid .vdel,
    .vmodal .vx {
      position: absolute;
      left: auto;
      bottom: auto;
    }
    .vid .vdel { top: 8px; right: 8px; z-index: 3; }
    .vmodal .vx { top: 10px; right: 12px; }
    #vprog { width: 100%; height: 8px; margin: 2px 0 8px; accent-color: var(--accent); }
    .lpick { display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px; }
    .lfile { font-size: 12px; color: var(--muted); word-break: break-all; }
    #lprev .thumb img { width: 160px; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border); }
    @media (max-width: 520px) {
      .vhead { flex-direction: column; align-items: flex-start; }
      .vacts { width: 100%; justify-content: flex-start; }
    }
  </style>

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const gridEl = $('grid'), emptyEl = $('empty');
    const gateEl = $('gate'), compEl = $('comp'), playEl = $('play'), delEl = $('del'), lcompEl = $('lcomp');
    const keyEl = $('key'), gmsgEl = $('gmsg');
    const dnameEl = $('dname'), dkeyEl = $('dkey'), dmsgEl = $('dmsg');
    const tEl = $('t'), uEl = $('u'), dEl = $('d'), fEl = $('f'), prevEl = $('prev'), hintEl = $('hint'), cmsgEl = $('cmsg');
    const vfEl = $('vf'), vfrmEl = $('vfrm'), vfhintEl = $('vfhint'), vprogEl = $('vprog');
    const ptitleEl = $('ptitle'), pbodyEl = $('pbody'), pmetaEl = $('pmeta');
    const lfEl = $('lf'), lfileEl = $('lfile'), lprevEl = $('lprev'), ltEl = $('lt'), ldEl = $('ld'), lmsgEl = $('lmsg');

    let KEY = '';
    try { KEY = sessionStorage.getItem('vkey') || ''; } catch (e) {}
    let cover = '';
    let busy = false;
    let serverFile = null, serverDuration = null, pendingUpload = '';

    // ---------- 本机视频（IndexedDB，仅当前浏览器） ----------
    const VDB = 'mfhry_videos_local';
    const VSTORE = 'videos';
    let localFile = null, localCover = '', localDuration = null, localProbe = 0;

    function vdbOpen() {
      return new Promise((resolve, reject) => {
        if (!('indexedDB' in window)) { reject(new Error('浏览器不支持本机视频')); return; }
        const req = indexedDB.open(VDB, 1);
        req.onupgradeneeded = () => {
          const d = req.result;
          if (!d.objectStoreNames.contains(VSTORE)) d.createObjectStore(VSTORE, { keyPath: 'id' });
        };
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error || new Error('打不开本机视频库'));
      });
    }

    async function localAll() {
      const d = await vdbOpen();
      return new Promise((resolve, reject) => {
        const r = d.transaction(VSTORE, 'readonly').objectStore(VSTORE).getAll();
        r.onsuccess = () => resolve(r.result || []);
        r.onerror = () => reject(r.error || new Error('读取本机视频失败'));
      });
    }

    async function localPut(rec) {
      const d = await vdbOpen();
      return new Promise((resolve, reject) => {
        const tx = d.transaction(VSTORE, 'readwrite');
        tx.objectStore(VSTORE).put(rec);
        tx.oncomplete = () => resolve(true);
        tx.onerror = () => reject(tx.error || new Error('保存本机视频失败'));
      });
    }

    async function localDel(id) {
      const d = await vdbOpen();
      return new Promise((resolve, reject) => {
        const tx = d.transaction(VSTORE, 'readwrite');
        tx.objectStore(VSTORE).delete(id);
        tx.oncomplete = () => resolve(true);
        tx.onerror = () => reject(tx.error || new Error('删除本机视频失败'));
      });
    }

    function probeVideo(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const v = document.createElement('video');
        let done = false, duration = null, cover = '', seekTimer = null;
        const finish = (ok) => {
          if (done) return;
          done = true;
          clearTimeout(timer);
          clearTimeout(seekTimer);
          try { v.removeAttribute('src'); v.load(); } catch (e) {}
          URL.revokeObjectURL(url);
          if (ok) resolve({ duration, cover });
          else reject(new Error('这个浏览器读不了这个视频格式'));
        };
        const timer = setTimeout(() => finish(false), 8000);
        v.preload = 'metadata';
        v.muted = true;
        v.playsInline = true;
        v.onloadedmetadata = () => {
          duration = Number.isFinite(v.duration) ? Math.round(v.duration) : null;
          // 有些 WebM 的时长是 Infinity，seek 也可能不触发；取不到封面也要能添加。
          seekTimer = setTimeout(() => finish(true), 2500);
          v.onseeked = () => {
            try {
              const vw = v.videoWidth || 640, vh = v.videoHeight || 360;
              const w = Math.min(640, vw), h = Math.round(w * vh / vw);
              const cv = document.createElement('canvas');
              cv.width = w; cv.height = h;
              cv.getContext('2d').drawImage(v, 0, 0, w, h);
              cover = cv.toDataURL('image/jpeg', 0.78);
            } catch (e) {}
            finish(true);
          };
          try { v.currentTime = Math.min(Math.max((duration || 1) * 0.1, 0.2), 2); } catch (e) {}
        };
        v.onerror = () => finish(false);
        v.src = url;
      });
    }

    function resetLocal() {
      localFile = null; localCover = ''; localDuration = null; localProbe++;
      lfEl.value = ''; ltEl.value = ''; ldEl.value = '';
      lprevEl.innerHTML = ''; lfileEl.textContent = '未选择';
      lmsgEl.textContent = ''; lmsgEl.classList.remove('ok');
    }

    // 粘 PeerTube 链接时自动补标题（这些站的 API 允许跨域）
    let ptTimer = null;
    uEl.addEventListener('input', () => {
      clearTimeout(ptTimer);
      const raw = uEl.value.trim();
      const pt = /^(https?:\/\/[^/]+)\/w\/([A-Za-z0-9]{18,24})/.exec(raw) ||
        /^(https?:\/\/[^/]+)\/videos\/watch\/([0-9a-f-]{36})/.exec(raw);
      if (!pt) return;
      ptTimer = setTimeout(async () => {
        try {
          const r = await fetch(pt[1] + '/api/v1/videos/' + pt[2]);
          if (!r.ok) return;
          const v = await r.json();
          if (!tEl.value.trim() && v && v.name) tEl.value = String(v.name).slice(0, 120);
        } catch (e) {}
      }, 500);
    });

    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmt = (t) => {
      if (!t) return '';
      const iso = String(t).includes('T') ? String(t) : String(t).replace(' ', 'T') + 'Z';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return String(t);
      return d.toLocaleString('sv-SE', { timeZone: 'Asia/Shanghai' }).slice(0, 16);
    };
    const dur = (s) => {
      const n = Number(s) || 0;
      if (!n) return '';
      const m = Math.floor(n / 60), r = n % 60;
      return m + ':' + String(r).padStart(2, '0');
    };

    function open(el) { el.hidden = false; document.body.style.overflow = 'hidden'; }
    function close(el) { el.hidden = true; if (gateEl.hidden && compEl.hidden && lcompEl.hidden && playEl.hidden && delEl.hidden) document.body.style.overflow = ''; }

    function playerHtml(url) {
      if (/^\/api\/video-stream\//.test(url)) {
        return '<video controls preload="metadata" playsinline src="' + esc(url) + '"></video>';
      }
      if (window.vplayerHtml) return window.vplayerHtml(url);
      return '<p class="nvlink"><a href="' + esc(url) + '" target="_blank" rel="noreferrer">打开视频 ↗</a></p>';
    }

    let VIDEOS = [];
    let localPlayUrl = '';

    function clearPlayer() {
      const vid = pbodyEl.querySelector('video');
      if (vid) { try { vid.pause(); vid.removeAttribute('src'); vid.load(); } catch (e) {} }
      pbodyEl.innerHTML = '';
      if (localPlayUrl) { URL.revokeObjectURL(localPlayUrl); localPlayUrl = ''; }
    }

    async function load() {
      let locals = [];
      try { locals = await localAll(); } catch (e) { console.warn('本机视频不可用', e); }
      let remote = [], remoteError = false;
      try {
        const res = await fetch('/api/videos', { cache: 'no-store' });
        const data = await res.json();
        remote = data.videos || [];
      } catch (e) { remoteError = true; }

      locals.sort((a, b) => String(b.created_at || '').localeCompare(String(a.created_at || '')));
      const all = [...locals, ...remote];
      VIDEOS = all;
      emptyEl.hidden = all.length > 0;
      gridEl.innerHTML = all.map((v) => {
        const isLocal = v.local === true;
        const c = isLocal ? (v.cover || '') : (v.cover ? '/api/media/' + v.cover : '');
        const dd = dur(v.duration);
        const meta = isLocal
          ? ['本机视频', dd, fmt(v.created_at)].filter(Boolean).join(' · ')
          : [(v.author ? esc(v.author) : ''), fmt(v.created_at)].filter(Boolean).join(' · ');
        return '<article class="vid' + (isLocal ? ' local' : '') + '" data-id="' + esc(String(v.id)) + '">' +
          '<div class="vthumb' + (c ? '' : ' noimg') + '">' + (c ? '<img loading="lazy" src="' + c + '" alt="" />' : '') +
          (isLocal ? '<span class="vlocal">本机</span>' : '') +
          '<span class="vplay">▶</span>' + (dd ? '<span class="vdur">' + dd + '</span>' : '') + '</div>' +
          '<div class="vmeta"><h3>' + esc(v.title) + '</h3><p>' + meta + '</p></div>' +
          '<button class="vdel" data-del="' + esc(String(v.id)) + '" title="' + (isLocal ? '删除本机视频' : '删除（需要口令）') + '">×</button>' +
          '</article>';
      }).join('');
      if (!all.length) emptyEl.textContent = remoteError ? '站内视频加载失败；也可以添加本机视频。' : '还没有视频。';
    }

    gridEl.addEventListener('click', async (e) => {
      const del = e.target.closest('.vdel');
      if (del) {
        e.stopPropagation();
        askDelete(del.dataset.del);
        return;
      }
      const card = e.target.closest('.vid');
      if (!card) return;
      const v = VIDEOS.find((x) => String(x.id) === card.dataset.id);
      if (!v) return;
      clearPlayer();
      ptitleEl.textContent = v.title || '';
      if (v.local === true) {
        if (!v.blob) {
          pbodyEl.innerHTML = '<p class="nvlink">这个本机视频的数据已经不在了，删掉后重新添加。</p>';
          open(playEl);
          return;
        }
        localPlayUrl = URL.createObjectURL(v.blob);
        pbodyEl.innerHTML = '<video controls autoplay playsinline src="' + localPlayUrl + '"></video>';
        pmetaEl.innerHTML = ['本机视频', dur(v.duration), fmt(v.created_at)].filter(Boolean).join(' · ');
      } else {
        pbodyEl.innerHTML = playerHtml(v.url);
        pmetaEl.innerHTML = [v.author ? esc(v.author) : '', dur(v.duration), fmt(v.created_at)].filter(Boolean).join(' · ') +
          ' · <a href="' + esc(v.url) + '" target="_blank" rel="noreferrer">原视频 ↗</a>';
      }
      if (v.body) pmetaEl.innerHTML += '<br />' + esc(v.body);
      open(playEl);
    });

    // 删除：站内视频要口令；本机视频只删当前浏览器，直接确认
    let delId = null;

    async function askDelete(id) {
      const v = VIDEOS.find((x) => String(x.id) === String(id));
      if (String(id).startsWith('local:')) {
        if (!v) return;
        if (!confirm('删除本机视频「' + (v.title || '未命名') + '」？只影响当前浏览器，文件不会上传或备份。')) return;
        try { await localDel(id); load(); } catch (e) { alert(e.message || '删除失败'); }
        return;
      }
      delId = id;
      dnameEl.textContent = v ? v.title : '';
      dkeyEl.value = '';
      dmsgEl.textContent = '';
      open(delEl);
      setTimeout(() => dkeyEl.focus(), 80);
    }

    async function doDelete() {
      const k = dkeyEl.value.trim();
      if (!k) { dmsgEl.textContent = '先输入口令'; return; }
      dmsgEl.textContent = '删除中…';
      try {
        const res = await fetch('/api/videos/' + delId, { method: 'DELETE', headers: { 'x-admin-key': k } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) { dmsgEl.textContent = data.error || '删除失败'; return; }
        KEY = k;
        try { sessionStorage.setItem('vkey', k); } catch (e) {}
        dmsgEl.textContent = '';
        delId = null;
        close(delEl);
        load();
      } catch (e) {
        dmsgEl.textContent = '网络错误，再试一次';
      }
    }

    $('dok').addEventListener('click', doDelete);
    $('dcancel').addEventListener('click', () => close(delEl));
    dkeyEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') doDelete(); });

    // 关闭
    document.addEventListener('click', (e) => {
      const c = e.target.closest('[data-close]');
      if (c) {
        const m = c.closest('.vmodal');
        if (m === compEl && busy) { cmsgEl.textContent = '正在上传，等完成再关闭'; return; }
        close(m);
        if (m === playEl) clearPlayer();
        return;
      }
      if (e.target.classList && e.target.classList.contains('vmodal')) {
        if (e.target === compEl && busy) { cmsgEl.textContent = '正在上传，等完成再关闭'; return; }
        close(e.target);
        if (e.target === playEl) clearPlayer();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      [gateEl, compEl, lcompEl, playEl, delEl].forEach((m) => {
        if (!m.hidden) {
          if (m === compEl && busy) return;
          close(m);
          if (m === playEl) clearPlayer();
        }
      });
    });

    // 本机视频
    const fmtBytes = (n) => n >= 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB';

    $('uplocal').addEventListener('click', () => {
      resetLocal();
      open(lcompEl);
    });
    $('lout').addEventListener('click', () => { close(lcompEl); resetLocal(); });

    lfEl.addEventListener('change', async () => {
      const file = (lfEl.files || [])[0];
      if (!file) return;
      localFile = file;
      localCover = ''; localDuration = null;
      const token = ++localProbe;
      lfileEl.textContent = file.name + ' · ' + fmtBytes(file.size);
      lmsgEl.textContent = '读取视频信息…';
      lmsgEl.classList.add('ok');
      try {
        const info = await probeVideo(file);
        if (token !== localProbe) return;
        localCover = info.cover;
        localDuration = info.duration;
        if (!ltEl.value.trim()) ltEl.value = file.name.replace(/\.[^.]+$/, '').slice(0, 120);
        lprevEl.innerHTML = info.cover ? '<span class="thumb"><img src="' + info.cover + '" alt="" /></span>' : '';
        lmsgEl.textContent = '已选择 · ' + fmtBytes(file.size) + (info.duration ? ' · ' + dur(info.duration) : '');
        lmsgEl.classList.add('ok');
      } catch (err) {
        if (token !== localProbe) return;
        localFile = null; localCover = ''; localDuration = null;
        lprevEl.innerHTML = '';
        lmsgEl.classList.remove('ok');
        lmsgEl.textContent = err.message || '这个浏览器读不了这个视频';
      }
    });

    $('lok').addEventListener('click', async () => {
      if (!localFile) { lmsgEl.textContent = '先选择一个视频文件'; return; }
      const title = (ltEl.value.trim() || localFile.name.replace(/\.[^.]+$/, '')).slice(0, 120);
      if (!title) { lmsgEl.textContent = '先填标题'; return; }
      const rec = {
        id: 'local:' + (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(16).slice(2)),
        local: true,
        title,
        body: ldEl.value.trim().slice(0, 2000) || null,
        author: '本机',
        duration: localDuration,
        created_at: new Date().toISOString(),
        mime: localFile.type || '',
        size: localFile.size,
        cover: localCover,
        blob: localFile,
      };
      lmsgEl.textContent = '保存中…';
      lmsgEl.classList.add('ok');
      try {
        // 尽量让浏览器别在空间紧张时自动清掉本机视频。
        try { if (navigator.storage && navigator.storage.persist) navigator.storage.persist().catch(() => {}); } catch (e) {}
        await localPut(rec);
        close(lcompEl);
        resetLocal();
        load();
      } catch (e) {
        lmsgEl.classList.remove('ok');
        const quota = e && (e.name === 'QuotaExceededError' || /quota|space/i.test(e.message || ''));
        lmsgEl.textContent = quota
          ? '浏览器空间不够：换小一点的视频，或清理站点数据后再试。'
          : (e.message || '保存失败');
      }
    });

    // 口令
    $('upbtn').addEventListener('click', () => {
      if (KEY) { open(compEl); return; }
      gmsgEl.textContent = '';
      keyEl.value = '';
      open(gateEl);
      setTimeout(() => keyEl.focus(), 80);
    });

    async function tryKey() {
      const k = keyEl.value.trim();
      if (!k) return;
      gmsgEl.textContent = '验证中…';
      gmsgEl.classList.add('ok');
      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ key: k }),
        });
        const data = await res.json();
        if (!res.ok) {
          gmsgEl.classList.remove('ok');
          gmsgEl.textContent = data.error || '口令不对';
          return;
        }
        KEY = k;
        try { sessionStorage.setItem('vkey', k); } catch (e) {}
        gmsgEl.textContent = '';
        close(gateEl);
        open(compEl);
        load();
      } catch (e) {
        gmsgEl.classList.remove('ok');
        gmsgEl.textContent = '网络错误，再试一次';
      }
    }
    $('gok').addEventListener('click', tryKey);
    keyEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') tryKey(); });

    $('cout').addEventListener('click', () => {
      if (busy) { cmsgEl.textContent = '正在上传，等完成再退出'; return; }
      KEY = '';
      try { sessionStorage.removeItem('vkey'); } catch (e) {}
      resetRemoteFields();
      close(compEl);
      load();
    });

    // 封面压缩
    function compress(file) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          const max = 1280;
          const s = Math.min(1, max / Math.max(img.width, img.height));
          const w = Math.round(img.width * s), h = Math.round(img.height * s);
          const cv = document.createElement('canvas');
          cv.width = w; cv.height = h;
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          URL.revokeObjectURL(url);
          let q = 0.85, data = cv.toDataURL('image/jpeg', q);
          while (data.length * 0.75 > 360 * 1024 && q > 0.4) { q -= 0.08; data = cv.toDataURL('image/jpeg', q); }
          resolve(data);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('load')); };
        img.src = url;
      });
    }

    fEl.addEventListener('change', async () => {
      const file = (fEl.files || [])[0];
      fEl.value = '';
      if (!file) return;
      try {
        cover = await compress(file);
        prevEl.innerHTML = '<span class="thumb"><img src="' + cover + '" alt="" /><button type="button" id="rmcover">×</button></span>';
        hintEl.textContent = '已选封面';
        $('rmcover').addEventListener('click', () => { cover = ''; prevEl.innerHTML = ''; hintEl.textContent = '封面可选（不填就用播放图标代替）'; });
      } catch (e) {
        hintEl.textContent = '这张图读不了，换一张';
      }
    });

    const SERVER_MAX = 40 * 1024 * 1024;

    function serverFileName(file) {
      return String(file.name || '视频').replace(/\.[^.]+$/, '').slice(0, 120);
    }

    function showCoverPreview() {
      if (!cover) { prevEl.innerHTML = ''; return; }
      prevEl.innerHTML = '<span class="thumb"><img src="' + cover + '" alt="" /><button type="button" id="rmcover">×</button></span>';
      $('rmcover').addEventListener('click', () => {
        cover = '';
        prevEl.innerHTML = '';
        hintEl.textContent = '封面可选（不填就用播放图标代替）';
      });
    }

    function resetRemoteFields() {
      serverFile = null; serverDuration = null; pendingUpload = '';
      vfEl.value = ''; vprogEl.hidden = true; vprogEl.value = 0;
      vfhintEl.textContent = '上传到服务器（≤40MB，实验性）；不选文件则用下方外链';
      tEl.value = ''; uEl.value = ''; dEl.value = ''; cover = '';
      prevEl.innerHTML = '';
      hintEl.textContent = '封面可选（不填就用播放图标代替）';
      cmsgEl.textContent = '';
    }

    async function abortServerUpload(id) {
      if (!id) return;
      try { await fetch('/api/video-upload?id=' + encodeURIComponent(id), { method: 'DELETE', headers: { 'x-admin-key': KEY } }); } catch (e) {}
      pendingUpload = '';
    }

    async function uploadServerVideo(file) {
      cmsgEl.textContent = '创建上传任务…';
      vprogEl.hidden = false; vprogEl.value = 1;
      const createRes = await fetch('/api/video-upload', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-admin-key': KEY },
        body: JSON.stringify({
          key: KEY,
          title: tEl.value.trim(),
          body: dEl.value.trim(),
          size: file.size,
          mime: file.type || 'video/mp4',
          duration: serverDuration,
          cover,
        }),
      });
      const task = await createRes.json().catch(() => ({}));
      if (!createRes.ok) throw new Error(task.error || '创建上传任务失败');
      pendingUpload = task.id;
      const chunkSize = Number(task.chunkSize) || 1500000;
      const group = chunkSize * 3;
      let sent = 0;

      while (sent < file.size) {
        const start = sent;
        const part = file.slice(start, Math.min(file.size, start + group));
        let attempt = 0;
        for (;;) {
          try {
            const res = await fetch('/api/video-upload?id=' + encodeURIComponent(task.id) + '&start=' + start, {
              method: 'POST',
              headers: { 'x-admin-key': KEY, 'content-type': 'application/octet-stream' },
              body: part,
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || '切片上传失败');
            break;
          } catch (e) {
            attempt++;
            if (attempt >= 3) throw e;
            cmsgEl.textContent = '网络抖动，重试切片 ' + attempt + '/3…';
            await new Promise(r => setTimeout(r, 700 * attempt));
          }
        }
        sent += part.size;
        const pct = Math.min(99, Math.round((sent / file.size) * 100));
        vprogEl.value = pct;
        cmsgEl.textContent = '上传中… ' + pct + '%（' + Math.ceil(sent / 1024 / 1024) + ' / ' + Math.ceil(file.size / 1024 / 1024) + 'MB）';
      }

      cmsgEl.textContent = '合并并发布…';
      vprogEl.value = 100;
      const finRes = await fetch('/api/video-upload?finish=' + encodeURIComponent(task.id), {
        method: 'POST',
        headers: { 'x-admin-key': KEY },
      });
      const fin = await finRes.json().catch(() => ({}));
      if (!finRes.ok) throw new Error(fin.error || '合并失败');
      pendingUpload = '';
    }

    vfEl.addEventListener('change', async () => {
      const file = (vfEl.files || [])[0];
      if (!file) return;
      if (file.size > SERVER_MAX) {
        vfEl.value = '';
        serverFile = null; serverDuration = null;
        vfrmEl.hidden = true; vprogEl.hidden = true; vprogEl.value = 0;
        cover = ''; prevEl.innerHTML = '';
        vfhintEl.textContent = '这个文件超过 40MB，换小一点的视频';
        return;
      }
      serverFile = file;
      serverDuration = null;
      vfrmEl.hidden = false;
      cover = '';
      showCoverPreview();
      if (!tEl.value.trim()) tEl.value = serverFileName(file);
      vfhintEl.textContent = file.name + ' · ' + (file.size / 1024 / 1024).toFixed(1) + 'MB · 读取信息中…';
      try {
        const info = await probeVideo(file);
        if (serverFile !== file) return;
        serverDuration = info.duration;
        if (info.cover) { cover = info.cover; showCoverPreview(); hintEl.textContent = '封面已自动截取'; }
        vfhintEl.textContent = file.name + ' · ' + (file.size / 1024 / 1024).toFixed(1) + 'MB · ' +
          (info.duration ? '时长 ' + Math.floor(info.duration / 60) + ':' + String(info.duration % 60).padStart(2, '0') : '时长未知') +
          '，将上传到服务器';
      } catch (e) {
        if (serverFile !== file) return;
        vfhintEl.textContent = file.name + ' · ' + (file.size / 1024 / 1024).toFixed(1) + 'MB · 浏览器读不出时长/封面，仍可上传';
      }
    });

    vfrmEl.addEventListener('click', () => {
      serverFile = null; serverDuration = null;
      vfEl.value = ''; vfrmEl.hidden = true; vprogEl.hidden = true; vprogEl.value = 0;
      cover = ''; prevEl.innerHTML = '';
      hintEl.textContent = '封面可选（不填就用播放图标代替）';
      vfhintEl.textContent = '上传到服务器（≤40MB，实验性）；不选文件则用下方外链';
    });

    $('cok').addEventListener('click', async () => {
      if (busy) return;
      const file = serverFile;
      const url = uEl.value.trim();
      if (!tEl.value.trim()) { cmsgEl.textContent = '先填标题'; return; }
      if (!file && !url) { cmsgEl.textContent = '选择本地视频，或填视频链接'; return; }
      if (!file && !/^https?:\/\//i.test(url)) { cmsgEl.textContent = '链接要以 http(s):// 开头'; return; }

      busy = true;
      try {
        if (file) {
          if (!KEY) { cmsgEl.textContent = '口令已失效，退出重进'; return; }
          await uploadServerVideo(file);
          resetRemoteFields();
          close(compEl);
          load();
          return;
        }

        cmsgEl.textContent = '上传中…';
        const res = await fetch('/api/videos', {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-admin-key': KEY },
          body: JSON.stringify({ key: KEY, title: tEl.value.trim(), url, body: dEl.value.trim(), cover }),
        });
        const data = await res.json();
        if (!res.ok) {
          cmsgEl.textContent = data.error || '上传失败';
          return;
        }
        resetRemoteFields();
        close(compEl);
        load();
      } catch (e) {
        if (pendingUpload) await abortServerUpload(pendingUpload);
        vprogEl.hidden = true;
        cmsgEl.textContent = e.message || '网络错误，再试一次';
      } finally {
        busy = false;
      }
    });

    load();
  </script>
</Base>
