---
import Base from '../layouts/Base.astro';
---
<Base title="视频">
  <div class="vhead">
    <h1>视频</h1>
    <button id="upbtn" class="send">＋ 上传</button>
  </div>
  <p class="muted">点开就看。上传、删除都要口令。</p>

  <div id="grid" class="vids"></div>
  <p class="muted" id="empty" hidden>还没有视频。</p>

  <!-- 口令 -->
  <div id="gate" class="vmodal" hidden>
    <div class="vbox small">
      <button class="vx" data-close type="button">×</button>
      <h2>输入口令</h2>
      <input id="key" class="key" type="password" placeholder="口令" autocomplete="current-password" />
      <p class="vmsg" id="gmsg"></p>
      <button id="gok" class="send" type="button">确认</button>
    </div>
  </div>

  <!-- 删除口令 -->
  <div id="del" class="vmodal" hidden>
    <div class="vbox small">
      <button class="vx" data-close type="button">×</button>
      <h2>删除视频</h2>
      <p class="muted" id="dname"></p>
      <input id="dkey" class="key" type="password" placeholder="输入口令" autocomplete="current-password" />
      <p class="vmsg" id="dmsg"></p>
      <div class="crow">
        <button id="dok" class="send" type="button">确认删除</button>
        <button id="dcancel" class="pick" type="button">取消</button>
      </div>
    </div>
  </div>

  <!-- 上传 -->
  <div id="comp" class="vmodal" hidden>
    <div class="vbox">
      <button class="vx" data-close type="button">×</button>
      <h2>上传视频</h2>
      <input id="t" class="key" type="text" maxlength="120" placeholder="标题（必填）" />
      <input id="u" class="key" type="url" placeholder="视频链接：B 站 / 腾讯 / 优酷 / 西瓜 / AcFun / YouTube / mp4 直链" />
      <textarea id="d" maxlength="2000" placeholder="简介（可选，最多 2000 字）"></textarea>
      <div class="crow">
        <label class="pick"><input id="f" type="file" accept="image/jpeg,image/png,image/webp" hidden />封面</label>
        <span class="muted" id="hint">封面可选（不填就用播放图标代替）</span>
      </div>
      <div id="prev" class="preview"></div>
      <p class="vmsg" id="cmsg"></p>
      <div class="crow">
        <button id="cok" class="send" type="button">发布</button>
        <button id="cout" class="pick" type="button">退出</button>
      </div>
    </div>
  </div>

  <!-- 播放 -->
  <div id="play" class="vmodal" hidden>
    <div class="vbox wide">
      <button class="vx" data-close type="button">×</button>
      <h2 id="ptitle"></h2>
      <div id="pbody" class="vplayer"></div>
      <p class="muted" id="pmeta"></p>
    </div>
  </div>

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const gridEl = $('grid'), emptyEl = $('empty');
    const gateEl = $('gate'), compEl = $('comp'), playEl = $('play'), delEl = $('del');
    const keyEl = $('key'), gmsgEl = $('gmsg');
    const dnameEl = $('dname'), dkeyEl = $('dkey'), dmsgEl = $('dmsg');
    const tEl = $('t'), uEl = $('u'), dEl = $('d'), fEl = $('f'), prevEl = $('prev'), hintEl = $('hint'), cmsgEl = $('cmsg');
    const ptitleEl = $('ptitle'), pbodyEl = $('pbody'), pmetaEl = $('pmeta');

    let KEY = '';
    try { KEY = sessionStorage.getItem('vkey') || ''; } catch (e) {}
    let cover = '';
    let busy = false;

    // 粘 PeerTube 链接时自动补标题（这些站的 API 允许跨域）
    let ptTimer = null;
    uEl.addEventListener('input', () => {
      clearTimeout(ptTimer);
      const raw = uEl.value.trim();
      const pt = /^(https?:\/\/[^/]+)\/w\/([A-Za-z0-9]{18,24})/.exec(raw) ||
        /^(https?:\/\/[^/]+)\/videos\/watch\/([0-9a-f-]{36})/.exec(raw);
      if (!pt) return;
      ptTimer = setTimeout(async () => {
        try {
          const r = await fetch(pt[1] + '/api/v1/videos/' + pt[2]);
          if (!r.ok) return;
          const v = await r.json();
          if (!tEl.value.trim() && v && v.name) tEl.value = String(v.name).slice(0, 120);
        } catch (e) {}
      }, 500);
    });

    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmt = (t) => {
      if (!t) return '';
      const iso = String(t).includes('T') ? String(t) : String(t).replace(' ', 'T') + 'Z';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return String(t);
      return d.toLocaleString('sv-SE', { timeZone: 'Asia/Shanghai' }).slice(0, 16);
    };
    const dur = (s) => {
      const n = Number(s) || 0;
      if (!n) return '';
      const m = Math.floor(n / 60), r = n % 60;
      return m + ':' + String(r).padStart(2, '0');
    };

    function open(el) { el.hidden = false; document.body.style.overflow = 'hidden'; }
    function close(el) { el.hidden = true; if (gateEl.hidden && compEl.hidden && playEl.hidden && delEl.hidden) document.body.style.overflow = ''; }

    function playerHtml(url) {
      if (window.vplayerHtml) return window.vplayerHtml(url);
      return '<p class="nvlink"><a href="' + esc(url) + '" target="_blank" rel="noreferrer">打开视频 ↗</a></p>';
    }

    let VIDEOS = [];

    async function load() {
      try {
        const res = await fetch('/api/videos', { cache: 'no-store' });
        const data = await res.json();
        const vs = data.videos || [];
        VIDEOS = vs;
        emptyEl.hidden = vs.length > 0;
        gridEl.innerHTML = vs.map((v) => {
          const c = v.cover ? '/api/media/' + v.cover : '';
          const dd = dur(v.duration);
          return '<article class="vid" data-id="' + v.id + '">' +
            '<div class="vthumb' + (c ? '' : ' noimg') + '">' + (c ? '<img loading="lazy" src="' + c + '" alt="" />' : '') +
            '<span class="vplay">▶</span>' + (dd ? '<span class="vdur">' + dd + '</span>' : '') + '</div>' +
            '<div class="vmeta"><h3>' + esc(v.title) + '</h3><p>' + (v.author ? esc(v.author) + ' · ' : '') + fmt(v.created_at) + '</p></div>' +
            '<button class="vdel" data-del="' + v.id + '" title="删除（需要口令）">×</button>' +
            '</article>';
        }).join('');
      } catch (e) {
        emptyEl.hidden = false;
        emptyEl.textContent = '加载失败，刷新试试。';
      }
    }

    gridEl.addEventListener('click', async (e) => {
      const del = e.target.closest('.vdel');
      if (del) {
        e.stopPropagation();
        askDelete(del.dataset.del);
        return;
      }
      const card = e.target.closest('.vid');
      if (!card) return;
      const v = VIDEOS.find((x) => String(x.id) === card.dataset.id);
      if (!v) return;
      ptitleEl.textContent = v.title || '';
      pbodyEl.innerHTML = playerHtml(v.url);
      pmetaEl.innerHTML = [v.author ? esc(v.author) : '', dur(v.duration), fmt(v.created_at)].filter(Boolean).join(' · ') +
        ' · <a href="' + esc(v.url) + '" target="_blank" rel="noreferrer">原视频 ↗</a>';
      if (v.body) pmetaEl.innerHTML += '<br />' + esc(v.body);
      open(playEl);
    });

    // 删除：每次都要口令
    let delId = null;

    function askDelete(id) {
      delId = id;
      const v = VIDEOS.find((x) => String(x.id) === String(id));
      dnameEl.textContent = v ? v.title : '';
      dkeyEl.value = '';
      dmsgEl.textContent = '';
      open(delEl);
      setTimeout(() => dkeyEl.focus(), 80);
    }

    async function doDelete() {
      const k = dkeyEl.value.trim();
      if (!k) { dmsgEl.textContent = '先输入口令'; return; }
      dmsgEl.textContent = '删除中…';
      try {
        const res = await fetch('/api/videos/' + delId, { method: 'DELETE', headers: { 'x-admin-key': k } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) { dmsgEl.textContent = data.error || '删除失败'; return; }
        KEY = k;
        try { sessionStorage.setItem('vkey', k); } catch (e) {}
        dmsgEl.textContent = '';
        delId = null;
        close(delEl);
        load();
      } catch (e) {
        dmsgEl.textContent = '网络错误，再试一次';
      }
    }

    $('dok').addEventListener('click', doDelete);
    $('dcancel').addEventListener('click', () => close(delEl));
    dkeyEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') doDelete(); });

    // 关闭
    document.addEventListener('click', (e) => {
      const c = e.target.closest('[data-close]');
      if (c) { close(c.closest('.vmodal')); if (c.closest('.vmodal') === playEl) pbodyEl.innerHTML = ''; return; }
      if (e.target.classList && e.target.classList.contains('vmodal')) {
        close(e.target);
        if (e.target === playEl) pbodyEl.innerHTML = '';
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      [gateEl, compEl, playEl, delEl].forEach((m) => { if (!m.hidden) { close(m); if (m === playEl) pbodyEl.innerHTML = ''; } });
    });

    // 口令
    $('upbtn').addEventListener('click', () => {
      if (KEY) { open(compEl); return; }
      gmsgEl.textContent = '';
      keyEl.value = '';
      open(gateEl);
      setTimeout(() => keyEl.focus(), 80);
    });

    async function tryKey() {
      const k = keyEl.value.trim();
      if (!k) return;
      gmsgEl.textContent = '验证中…';
      gmsgEl.classList.add('ok');
      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ key: k }),
        });
        const data = await res.json();
        if (!res.ok) {
          gmsgEl.classList.remove('ok');
          gmsgEl.textContent = data.error || '口令不对';
          return;
        }
        KEY = k;
        try { sessionStorage.setItem('vkey', k); } catch (e) {}
        gmsgEl.textContent = '';
        close(gateEl);
        open(compEl);
        load();
      } catch (e) {
        gmsgEl.classList.remove('ok');
        gmsgEl.textContent = '网络错误，再试一次';
      }
    }
    $('gok').addEventListener('click', tryKey);
    keyEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') tryKey(); });

    $('cout').addEventListener('click', () => {
      KEY = '';
      try { sessionStorage.removeItem('vkey'); } catch (e) {}
      close(compEl);
      load();
    });

    // 封面压缩
    function compress(file) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          const max = 1280;
          const s = Math.min(1, max / Math.max(img.width, img.height));
          const w = Math.round(img.width * s), h = Math.round(img.height * s);
          const cv = document.createElement('canvas');
          cv.width = w; cv.height = h;
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          URL.revokeObjectURL(url);
          let q = 0.85, data = cv.toDataURL('image/jpeg', q);
          while (data.length * 0.75 > 360 * 1024 && q > 0.4) { q -= 0.08; data = cv.toDataURL('image/jpeg', q); }
          resolve(data);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('load')); };
        img.src = url;
      });
    }

    fEl.addEventListener('change', async () => {
      const file = (fEl.files || [])[0];
      fEl.value = '';
      if (!file) return;
      try {
        cover = await compress(file);
        prevEl.innerHTML = '<span class="thumb"><img src="' + cover + '" alt="" /><button type="button" id="rmcover">×</button></span>';
        hintEl.textContent = '已选封面';
        $('rmcover').addEventListener('click', () => { cover = ''; prevEl.innerHTML = ''; hintEl.textContent = '封面可选（不填就用播放图标代替）'; });
      } catch (e) {
        hintEl.textContent = '这张图读不了，换一张';
      }
    });

    $('cok').addEventListener('click', async () => {
      if (busy) return;
      const url = uEl.value.trim();
      if (!tEl.value.trim()) { cmsgEl.textContent = '先填标题'; return; }
      if (!url) { cmsgEl.textContent = '先填视频链接'; return; }
      if (!/^https?:\/\//i.test(url)) { cmsgEl.textContent = '链接要以 http(s):// 开头'; return; }
      busy = true;
      cmsgEl.textContent = '上传中…';
      try {
        const res = await fetch('/api/videos', {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-admin-key': KEY },
          body: JSON.stringify({ key: KEY, title: tEl.value.trim(), url, body: dEl.value.trim(), cover }),
        });
        const data = await res.json();
        if (!res.ok) {
          cmsgEl.textContent = data.error || '上传失败';
          return;
        }
        cmsgEl.textContent = '';
        tEl.value = ''; uEl.value = ''; dEl.value = ''; cover = '';
        prevEl.innerHTML = '';
        hintEl.textContent = '封面可选（不填就用播放图标代替）';
        close(compEl);
        load();
      } catch (e) {
        cmsgEl.textContent = '网络错误，再试一次';
      } finally {
        busy = false;
      }
    });

    load();
  </script>
</Base>
