---
import Base from '../layouts/Base.astro';
---
<Base title="新闻">
  <h1>新闻</h1>
  <p class="muted">本站发布的消息。 <a href="/news/post">管理</a></p>

  <div id="list" class="news"></div>
  <p class="muted" id="empty" hidden>还没有新闻。</p>

  <script is:inline>
    const listEl = document.getElementById('list');
    const emptyEl = document.getElementById('empty');
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmt = (t) => {
      if (!t) return '';
      const iso = String(t).includes('T') ? String(t) : String(t).replace(' ', 'T') + 'Z';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return String(t);
      return d.toLocaleString('sv-SE', { timeZone: 'Asia/Shanghai' }).slice(0, 16);
    };

    function videoHtml(url) {
      if (!url) return '';
      if (window.vplayerHtml) return window.vplayerHtml(url);
      const u = esc(url);
      return '<p class="nvlink"><a href="' + u + '" target="_blank" rel="noreferrer">打开视频 ↗</a></p>';
    }

    function xHtml(x, pid) {
      if (!x) return '';
      if (x.error) return '<p class="nvlink"><a href="' + esc(x.url) + '" target="_blank" rel="noreferrer">X 链接（' + esc(x.error) + '）↗</a></p>';
      const pics = (x.images || [])
        .map((id) => '<a href="/api/media/' + id + '" target="_blank" rel="noreferrer"><img loading="lazy" src="/api/media/' + id + '" alt="" /></a>')
        .join('');
      return (
        '<div class="xcard">' +
        '<div class="xhead"><b>' + esc(x.author || 'X') + '</b><span>@' + esc(x.handle || '') + '</span></div>' +
        (x.text ? '<p class="xtext" id="xt-' + pid + '" data-plain="' + esc(x.text) + '" data-tr="0">' + esc(x.text) + '</p><button class="trbtn" data-t="xt-' + pid + '">译</button>' : '') +
        (pics ? '<div class="xgallery">' + pics + '</div>' : '') +
        '<div class="xfoot"><a href="' + esc(x.url) + '" target="_blank" rel="noreferrer">' + esc(x.date || '查看原帖') + ' · X ↗</a></div>' +
        '</div>'
      );
    }

    listEl.addEventListener('click', async (e) => {
      const btn = e.target.closest('.trbtn');
      if (!btn) return;
      const el = document.getElementById(btn.dataset.t);
      if (!el) return;
      if (el.dataset.tr === '1') {
        el.innerHTML = el.dataset.orig;
        el.dataset.tr = '0';
        btn.textContent = '译';
        return;
      }
      el.dataset.orig = el.innerHTML;
      btn.textContent = '…';
      try {
        const r = await fetch('/api/translate?text=' + encodeURIComponent(el.dataset.plain));
        const j = await r.json();
        if (j.error) throw new Error(j.error);
        el.textContent = j.text;
        el.dataset.tr = '1';
        btn.textContent = '原';
      } catch {
        btn.textContent = '译';
      }
    });

    (async () => {
      const res = await fetch('/api/news', { cache: 'no-store' });
      const data = await res.json();
      const news = data.news || [];
      emptyEl.hidden = news.length > 0;

      listEl.innerHTML = news
        .map((n) => {
          const imgs = n.images || [];
          const hero = imgs.length
            ? '<div class="nhero"><a href="/api/media/' + imgs[0] + '" target="_blank" rel="noreferrer"><img loading="lazy" src="/api/media/' + imgs[0] + '" alt=""></a></div>'
            : '';
          const extra = imgs.length > 1
            ? '<div class="ngallery">' + imgs.slice(1).map((id) => '<a href="/api/media/' + id + '" target="_blank" rel="noreferrer"><img loading="lazy" src="/api/media/' + id + '" alt=""></a>').join('') + '</div>'
            : '';
          return (
            '<article class="newscard narticle" id="news-' + n.id + '">' +
            '<div class="nmeta"><time>' + esc(fmt(n.created_at)) + '</time></div>' +
            hero +
            '<div class="nmain">' +
            '<h2 class="ntitle">' + esc(n.title) + '</h2>' +
            (n.body ? '<div class="nbody" id="nb-' + n.id + '" data-plain="' + esc(n.body) + '" data-tr="0">' + esc(n.body).replace(/\n/g, '<br>') + '</div><button class="trbtn" data-t="nb-' + n.id + '">译</button>' : '') +
            extra +
            videoHtml(n.video) +
            xHtml(n.x, n.id) +
            '</div>' +
            '</article>'
          );
        })
        .join('');
    })();
  </script>

  <style>
    /* 新闻详情（照 NVIDIA 博客样式）：日期 → 大配图 → 正文 */
    .news { display: flex; flex-direction: column; gap: 34px; }
    .narticle {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 0;
      border: 0;
      background: transparent;
    }
    .nmeta { font-size: 12.5px; color: var(--muted); letter-spacing: .02em; }
    .nmeta time { color: var(--muted); }
    .nhero {
      width: 100%;
      border-radius: 6px;
      overflow: hidden;
      background: #000;
    }
    .nhero img { width: 100%; height: auto; display: block; object-fit: cover; }
    .nmain { display: flex; flex-direction: column; gap: 10px; }
    .nmain .ntitle { font-size: 22px; font-weight: 650; line-height: 1.35; margin: 0; }
    .nbody { font-size: 15px; line-height: 1.95; color: var(--fg); word-break: break-word; }
    .narticle .ngallery { margin: 12px 0 0; }
  </style>

</Base>
