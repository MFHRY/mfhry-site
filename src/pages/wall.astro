---
import Base from '../layouts/Base.astro';
---
<Base title="墙">
  <h1>墙</h1>
  <p class="muted">匿名留言，不记名。每 IP 每小时 5 条，最多 9 张图；视频可直接上传（≤80MB，分片上传）或填链接。</p>

  <div class="composer">
    <input id="nick" class="key" type="text" maxlength="20" placeholder="网名（可选，留空即匿名）" />
    <textarea id="body" maxlength="500" placeholder="说点什么…（最多 500 字）"></textarea>
    <input id="video" class="key" type="url" placeholder="视频链接（B 站 / 腾讯 / 优酷 / 西瓜 / AcFun / YouTube / mp4 直链），可留空" />
    <input id="x" class="key" type="url" placeholder="X（推特）链接，可留空，内容会存到本站" />
    <div class="crow">
      <label class="pick"><input id="file" type="file" accept="image/jpeg,image/png,image/webp" multiple hidden />图片</label>
      <label class="pick"><input id="vfile" type="file" accept="video/*" hidden />视频</label>
      <button id="vrm" class="pick" type="button" hidden>清除视频</button>
      <span class="muted" id="hint">最多 9 张，自动压缩</span>
      <span class="muted" id="vhint"></span>
      <button id="send" class="send">发布</button>
    </div>
    <div id="preview" class="preview"></div>
  </div>

  <div id="list" class="wall"></div>
  <p class="muted" id="empty" hidden>还没有人留言，来当第一个。</p>

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const nickEl = $('nick'), bodyEl = $('body'), videoEl = $('video'), xEl = $('x'), fileEl = $('file');
    const sendEl = $('send'), listEl = $('list'), emptyEl = $('empty'), previewEl = $('preview'), hintEl = $('hint');
    const vfileEl = $('vfile'), vrmEl = $('vrm'), vhintEl = $('vhint');
    let images = [], busy = false, videoFile = null;

    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmt = (t) => {
      if (!t) return '';
      const iso = String(t).includes('T') ? String(t) : String(t).replace(' ', 'T') + 'Z';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return String(t);
      return d.toLocaleString('sv-SE', { timeZone: 'Asia/Shanghai' }).slice(0, 16);
    };

    function videoHtml(url) {
      if (!url) return '';
      if (/^\/api\/(?:r2\?key=|video-stream\/)/.test(url)) {
        return '<div class="nvideo vfile"><video controls preload="metadata" playsinline src="' + esc(url) + '"></video></div>';
      }
      if (window.vplayerHtml) return window.vplayerHtml(url);
      const u = esc(url);
      let m = url.match(/bilibili\.com\/video\/(BV[0-9A-Za-z]+)/i);
      if (m) return '<div class="nvideo"><iframe src="https://player.bilibili.com/player.html?bvid=' + m[1] + '&page=1&autoplay=0" allowfullscreen></iframe></div>';
      m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([0-9A-Za-z_-]{6,})/i);
      if (m) return '<p class="nvlink"><a href="' + u + '" target="_blank" rel="noreferrer">YouTube 视频（大陆需科学上网）↗</a></p>';
      if (/\.(mp4|webm|ogg)(\?|#|$)/i.test(url)) return '<div class="nvideo"><video controls preload="metadata" src="' + u + '"></video></div>';
      return '<p class="nvlink"><a href="' + u + '" target="_blank" rel="noreferrer">打开视频 ↗</a></p>';
    }

    function xHtml(x, pid) {
      if (!x) return '';
      if (x.error) return '<p class="nvlink"><a href="' + esc(x.url) + '" target="_blank" rel="noreferrer">X 链接（' + esc(x.error) + '）↗</a></p>';
      const pics = (x.images || [])
        .map((id) => '<a href="/api/media/' + id + '" target="_blank" rel="noreferrer"><img loading="lazy" src="/api/media/' + id + '" alt="" /></a>')
        .join('');
      return (
        '<div class="xcard">' +
        '<div class="xhead"><b>' + esc(x.author || 'X') + '</b><span>@' + esc(x.handle || '') + '</span></div>' +
        (x.text ? '<p class="xtext" id="xt-' + pid + '" data-plain="' + esc(x.text) + '" data-tr="0">' + esc(x.text) + '</p><button class="trbtn" data-t="xt-' + pid + '">译</button>' : '') +
        (pics ? '<div class="xgallery">' + pics + '</div>' : '') +
        '<div class="xfoot"><a href="' + esc(x.url) + '" target="_blank" rel="noreferrer">' + esc(x.date || '查看原帖') + ' · X ↗</a></div>' +
        '</div>'
      );
    }

    function compress(file) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          const max = 1200;
          const s = Math.min(1, max / Math.max(img.width, img.height));
          const w = Math.round(img.width * s), h = Math.round(img.height * s);
          const cv = document.createElement('canvas');
          cv.width = w; cv.height = h;
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          URL.revokeObjectURL(url);
          let q = 0.82, data = cv.toDataURL('image/jpeg', q);
          while (data.length * 0.75 > 340 * 1024 && q > 0.4) { q -= 0.08; data = cv.toDataURL('image/jpeg', q); }
          resolve(data);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('load')); };
        img.src = url;
      });
    }

    function renderPreview() {
      previewEl.innerHTML = images
        .map((d, i) => '<span class="thumb"><img src="' + d + '" alt="" /><button data-i="' + i + '">×</button></span>')
        .join('');
      previewEl.querySelectorAll('button').forEach((b) =>
        b.addEventListener('click', () => { images.splice(Number(b.dataset.i), 1); renderPreview(); })
      );
      updateHint();
    }

    function updateHint() {
      const parts = [];
      if (images.length) parts.push('已选 ' + images.length + ' 张图');
      if (videoFile) parts.push('视频 ' + (videoFile.size / 1024 / 1024).toFixed(1) + 'MB');
      hintEl.textContent = parts.length ? parts.join(' · ') : '最多 9 张，视频 ≤80MB';
    }

    fileEl.addEventListener('change', async () => {
      const files = [...(fileEl.files || [])].slice(0, 9 - images.length);
      for (const f of files) { try { images.push(await compress(f)); } catch (e) {} }
      fileEl.value = '';
      renderPreview();
    });

    vfileEl.addEventListener('change', () => {
      const f = (vfileEl.files || [])[0];
      vfileEl.value = '';
      if (!f) return;
      if (f.size > 80 * 1024 * 1024) {
        videoFile = null; vrmEl.hidden = true; vhintEl.textContent = '视频最多 80MB';
        updateHint();
        return;
      }
      videoFile = f;
      vrmEl.hidden = false;
      vhintEl.textContent = f.name + ' · ' + (f.size / 1024 / 1024).toFixed(1) + 'MB';
      updateHint();
    });

    vrmEl.addEventListener('click', () => {
      videoFile = null; vfileEl.value = ''; vrmEl.hidden = true; vhintEl.textContent = '';
      updateHint();
    });

    function uploadWallVideo(file, onProgress) {
      // 分片上传：create → 逐片 PUT → complete（匿名，无口令）
      const MP = 8 * 1024 * 1024;
      return (async () => {
        const cre = await fetch('/api/r2-mp?action=create', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name: file.name || 'video', mime: file.type || 'video/mp4', size: file.size }),
        });
        const cd = await cre.json().catch(() => ({}));
        if (!cre.ok || !cd.uploadId) throw new Error(cd.error || '创建上传失败');
        const key = cd.key, uploadId = cd.uploadId;
        const total = file.size;
        const parts = [];
        let loaded = 0;
        try {
          for (let off = 0, idx = 1; off < total; off += MP, idx++) {
            const blob = file.slice(off, Math.min(off + MP, total));
            let lastErr = null;
            for (let attempt = 0; attempt < 3; attempt++) {
              try {
                const r = await fetch('/api/r2-mp?action=part&key=' + encodeURIComponent(key) +
                  '&uploadId=' + encodeURIComponent(uploadId) + '&partNumber=' + idx, {
                  method: 'PUT', body: blob,
                });
                const d = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(d.error || '分片失败');
                parts.push({ partNumber: d.partNumber, etag: d.etag });
                loaded += blob.size;
                if (onProgress) onProgress(Math.min(99, Math.round((loaded / total) * 100)));
                lastErr = null; break;
              } catch (e) {
                lastErr = e;
                await new Promise((r2) => setTimeout(r2, 600 * (attempt + 1)));
              }
            }
            if (lastErr) throw lastErr;
          }
          const cm = await fetch('/api/r2-mp?action=complete&key=' + encodeURIComponent(key) +
            '&uploadId=' + encodeURIComponent(uploadId), {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ parts, size: total }),
          });
          const cmd = await cm.json().catch(() => ({}));
          if (!cm.ok || !cmd.url) throw new Error(cmd.error || '合并分片失败');
          return cmd;
        } catch (e) {
          try {
            await fetch('/api/r2-mp?action=abort&key=' + encodeURIComponent(key) +
              '&uploadId=' + encodeURIComponent(uploadId), { method: 'DELETE' });
          } catch (e2) {}
          throw e;
        }
      })();
    }

    const CN = { CN: '中国', HK: '中国香港', TW: '中国台湾', MO: '中国澳门', JP: '日本', US: '美国', SG: '新加坡', KR: '韩国', GB: '英国', DE: '德国', AU: '澳大利亚', CA: '加拿大', MY: '马来西亚', TH: '泰国', VN: '越南', FR: '法国', RU: '俄罗斯', IN: '印度', ID: '印度尼西亚', PH: '菲律宾', NL: '荷兰' };
    const flag = (c) => (/^[A-Z]{2}$/.test(c || '') ? String.fromCodePoint(...[...c].map((x) => 0x1f1e6 + x.charCodeAt(0) - 65)) : '🌐');
    function loc(p) {
      const parts = [];
      if (p.region && p.region !== p.city) parts.push(p.region);
      if (p.city) parts.push(p.city);
      const place = parts.length ? parts.join(' · ') : '未知地区';
      return flag(p.country) + ' ' + place + (p.ip ? ' · ' + p.ip : '');
    }

    async function load() {
      const res = await fetch('/api/wall?limit=50', { cache: 'no-store' });
      const data = await res.json();
      const posts = data.posts || [];
      emptyEl.hidden = posts.length > 0;
      listEl.innerHTML = posts
        .map((p) => {
          const gallery = (p.images || []).length
            ? '<div class="ngallery">' + p.images.map((id) => '<a href="/api/media/' + id + '" target="_blank" rel="noreferrer"><img loading="lazy" src="/api/media/' + id + '" alt="" /></a>').join('') + '</div>'
            : '';
          const who = p.user
            ? '<span class="nick acct" title="老账号发的（登录功能已下线）">' +
              (p.user.avatar
                ? '<img class="nav" src="' + esc(p.user.avatar) + '" alt="" width="18" height="18" loading="lazy" />'
                : '<span class="ini">' + esc((p.user.display || p.user.login).slice(0, 1).toUpperCase()) + '</span>') +
              esc(p.user.display || p.user.login) +
              (p.user.verified ? '<span class="vfy" title="已验证">✓</span>' : '') +
              '</span>'
            : p.nickname
              ? '<span class="nick">' + esc(p.nickname) + '</span>'
              : '<span class="nick anon">匿名</span>';
          return (
            '<article class="post">' +
            '<button class="delpost" type="button" data-id="' + esc(String(p.id)) + '" title="删除整条帖子（需要口令）">×</button>' +
            '<header><span class="pid">#' + p.id + '</span>' + who + '<time>' + esc(fmt(p.created_at)) + '</time></header>' +
            '<p class="geo">' + esc(loc(p)) + '</p>' +
            (p.body ? '<p class="pbody" id="pb-' + p.id + '" data-plain="' + esc(p.body) + '" data-tr="0">' + esc(p.body).replace(/\n/g, '<br>') + '</p><button class="trbtn" data-t="pb-' + p.id + '">译</button>' : '') +
            gallery + videoHtml(p.video) + xHtml(p.x, p.id) +
            '</article>'
          );
        })
        .join('');
    }

    listEl.addEventListener('click', async (e) => {
      const delpost = e.target.closest('.delpost');
      if (delpost) {
        let key = '';
        try { key = sessionStorage.getItem('wkey') || ''; } catch (e2) {}
        if (!key) {
          key = prompt('输入口令，删除这条帖子：') || '';
          if (!key) return;
        }
        delpost.disabled = true; delpost.textContent = '…';
        const attempt = async (k) => {
          const r = await fetch('/api/wall/' + encodeURIComponent(delpost.dataset.id), {
            method: 'DELETE',
            headers: { 'x-admin-key': k },
          });
          return { r, d: await r.json().catch(() => ({})) };
        };
        try {
          let out = await attempt(key);
          if (out.r.status === 403 && sessionStorage.getItem('wkey')) {
            sessionStorage.removeItem('wkey');
            const k2 = prompt('口令已失效，重新输入：') || '';
            if (!k2) { delpost.disabled = false; delpost.textContent = '×'; return; }
            key = k2;
            out = await attempt(key);
          }
          if (!out.r.ok) throw new Error(out.d.error || '删除失败');
          try { sessionStorage.setItem('wkey', key); } catch (e3) {}
          const art = delpost.closest('.post');
          if (art) {
            art.querySelectorAll('video').forEach((vd) => {
              try { vd.pause(); vd.removeAttribute('src'); vd.load(); } catch (e4) {}
            });
            art.remove();
          }
          if (!document.querySelectorAll('.post').length && document.getElementById('empty')) {
            document.getElementById('empty').hidden = false;
          }
        } catch (err) {
          alert(err.message || '删除失败');
          delpost.disabled = false; delpost.textContent = '×';
        }
        return;
      }
      const btn = e.target.closest('.trbtn');
      if (!btn) return;
      const el = document.getElementById(btn.dataset.t);
      if (!el) return;
      if (el.dataset.tr === '1') {
        el.innerHTML = el.dataset.orig;
        el.dataset.tr = '0';
        btn.textContent = '译';
        return;
      }
      el.dataset.orig = el.innerHTML;
      btn.textContent = '…';
      try {
        const r = await fetch('/api/translate?text=' + encodeURIComponent(el.dataset.plain));
        const j = await r.json();
        if (j.error) throw new Error(j.error);
        el.textContent = j.text;
        el.dataset.tr = '1';
        btn.textContent = '原';
      } catch {
        btn.textContent = '译';
      }
    });

    sendEl.addEventListener('click', async () => {
      if (busy) return;
      const text = bodyEl.value.trim();
      const videoLink = videoEl.value.trim();
      if (!text && !images.length && !videoFile && !videoLink) {
        hintEl.textContent = '写点字、选张图、传个视频或贴个链接';
        return;
      }
      busy = true; sendEl.disabled = true; sendEl.textContent = '发布中…';
      let uploadedKey = '';
      try {
        let video = videoLink;
        if (videoFile) {
          hintEl.textContent = '视频上传中… 0%';
          const up = await uploadWallVideo(videoFile, (pct) => { hintEl.textContent = '视频上传中… ' + pct + '%'; });
          uploadedKey = up.key;
          video = up.url;
        }

        const res = await fetch('/api/wall', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ body: text, nickname: nickEl.value.trim(), images, video, x: xEl.value.trim() }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '发布失败');
        uploadedKey = '';
        bodyEl.value = ''; videoEl.value = ''; xEl.value = '';
        images = [];
        videoFile = null; vfileEl.value = ''; vrmEl.hidden = true; vhintEl.textContent = '';
        renderPreview();
        await load();
      } catch (e) {
        if (uploadedKey) {
          try { await fetch('/api/r2-mp?action=delete&key=' + encodeURIComponent(uploadedKey), { method: 'DELETE' }); } catch {}
        }
        hintEl.textContent = e.message;
      } finally {
        busy = false; sendEl.disabled = false; sendEl.textContent = '发布';
      }
    });

    load();
  </script>

  <style is:global>
    /* 本地上传的视频按原始比例显示，竖屏不强行裁成 16:9 */
    .nvideo.vfile video {
      aspect-ratio: auto;
      max-height: 70vh;
      min-height: 180px;
      object-fit: contain;
    }
    #vhint { font-size: 11.5px; word-break: break-all; }
    #list .post { position: relative; }
    #list .post header { padding-right: 28px; }
    #list .delpost {
      position: absolute; top: 8px; right: 8px; z-index: 3;
      width: 22px; height: 22px; line-height: 1;
      background: rgba(8, 20, 16, .45); color: rgba(255, 255, 255, .55);
      border: 1px solid rgba(255, 255, 255, .12); border-radius: 6px;
      font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center;
      overflow: visible;
    }
    #list .delpost:hover { color: #ff8f8f; border-color: rgba(255, 143, 143, .45); }
  </style>
</Base>
