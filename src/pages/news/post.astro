---
import Base from '../../layouts/Base.astro';
---
<Base title="发布新闻" noindex={true}>
  <p class="crumb"><a href="/news">← 新闻</a></p>
  <h1>发布新闻</h1>
  <p class="muted">只有持有口令的人能发布。图片最多 9 张，视频填链接。</p>

  <div class="composer">
    <input id="key" class="key" type="password" placeholder="管理口令" autocomplete="off" />
    <input id="title" class="ntitle-input" type="text" maxlength="100" placeholder="标题" />
    <textarea id="body" maxlength="5000" placeholder="正文（可换行，最多 5000 字）"></textarea>

    <input id="video" class="key" type="url" placeholder="视频链接（B 站 / 腾讯 / 优酷 / 西瓜 / AcFun / YouTube / mp4 直链），可留空" />
    <input id="x" class="key" type="url" placeholder="X（推特）链接，可留空，正文和配图会存到本站" />

    <div class="crow">
      <label class="pick"><input id="file" type="file" accept="image/jpeg,image/png,image/webp" multiple hidden />添加图片</label>
      <span class="muted" id="hint">最多 9 张，自动压缩</span>
      <button id="send" class="send">发布</button>
    </div>
    <div id="preview" class="preview"></div>
  </div>

  <h2 style="margin:26px 0 10px;font-size:16px">已发布</h2>
  <div id="list" class="news"></div>

  <script is:inline>
    const $ = (id) => document.getElementById(id);
    const keyEl = $('key'), titleEl = $('title'), bodyEl = $('body'), videoEl = $('video'), xEl = $('x');
    const fileEl = $('file'), hintEl = $('hint'), previewEl = $('preview'), listEl = $('list'), sendEl = $('send');
    let images = [], busy = false;

    keyEl.value = localStorage.getItem('mfhry_admin') || '';
    keyEl.addEventListener('change', () => localStorage.setItem('mfhry_admin', keyEl.value.trim()));

    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmt = (t) => {
      if (!t) return '';
      const iso = String(t).includes('T') ? String(t) : String(t).replace(' ', 'T') + 'Z';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return String(t);
      return d.toLocaleString('sv-SE', { timeZone: 'Asia/Shanghai' }).slice(0, 16);
    };

    function compress(file) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          const max = 1400;
          const s = Math.min(1, max / Math.max(img.width, img.height));
          const w = Math.round(img.width * s), h = Math.round(img.height * s);
          const cv = document.createElement('canvas');
          cv.width = w; cv.height = h;
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          URL.revokeObjectURL(url);
          let q = 0.85, data = cv.toDataURL('image/jpeg', q);
          while (data.length * 0.75 > 360 * 1024 && q > 0.4) { q -= 0.08; data = cv.toDataURL('image/jpeg', q); }
          resolve(data);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('load')); };
        img.src = url;
      });
    }

    function renderPreview() {
      previewEl.innerHTML = images
        .map((d, i) => '<span class="thumb"><img src="' + d + '" alt="" /><button data-i="' + i + '">×</button></span>')
        .join('');
      previewEl.querySelectorAll('button').forEach((b) =>
        b.addEventListener('click', () => { images.splice(Number(b.dataset.i), 1); renderPreview(); })
      );
      hintEl.textContent = images.length ? '已选 ' + images.length + ' 张' : '最多 9 张，自动压缩';
    }

    fileEl.addEventListener('change', async () => {
      const files = [...(fileEl.files || [])].slice(0, 9 - images.length);
      for (const f of files) {
        try { images.push(await compress(f)); } catch (e) {}
      }
      fileEl.value = '';
      renderPreview();
    });

    async function load() {
      const data = await (await fetch('/api/news', { cache: 'no-store' })).json();
      listEl.innerHTML = (data.news || [])
        .map(
          (n) =>
            '<article class="newscard"><header><span class="ntitle">' + esc(n.title) + '</span><time>' + esc(fmt(n.created_at)) + '</time></header>' +
            '<div class="nbody">' + esc(n.body || '').replace(/\n/g, '<br>') + '</div>' +
            '<div class="muted" style="font-size:12px;margin-top:6px">' +
            (n.images || []).length + ' 张图' + (n.video ? ' · 有视频链接' : '') +
            '</div>' +
            '<button class="del" data-id="' + n.id + '">删除</button></article>'
        )
        .join('');
      listEl.querySelectorAll('.del').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('删除这条新闻？')) return;
          const r = await fetch('/api/news/' + b.dataset.id, { method: 'DELETE', headers: { 'x-admin-key': keyEl.value.trim() } });
          if (!r.ok) { alert((await r.json()).error || '删除失败'); return; }
          load();
        })
      );
    }

    sendEl.addEventListener('click', async () => {
      if (busy) return;
      const key = keyEl.value.trim();
      if (!key) { hintEl.textContent = '先填管理口令'; return; }
      if (!titleEl.value.trim()) { hintEl.textContent = '标题不能为空'; return; }
      busy = true; sendEl.disabled = true; sendEl.textContent = '发布中…';
      try {
        const res = await fetch('/api/news', {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-admin-key': key },
          body: JSON.stringify({ key, title: titleEl.value.trim(), body: bodyEl.value.trim(), video: videoEl.value.trim(), x: xEl.value.trim(), images }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '发布失败');
        localStorage.setItem('mfhry_admin', key);
        titleEl.value = ''; bodyEl.value = ''; videoEl.value = ''; xEl.value = '';
        images = []; renderPreview(); hintEl.textContent = '已发布';
        load();
      } catch (e) {
        hintEl.textContent = e.message;
      } finally {
        busy = false; sendEl.disabled = false; sendEl.textContent = '发布';
      }
    });

    load();
  </script>
</Base>
