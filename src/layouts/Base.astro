---
import '../styles/global.css';
import site from '../data/site.json';

const { title = '首页', noindex = false } = Astro.props;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.tagline} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/vplayer.js"></script>
    <title>{title} · {site.name}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/">{site.name}</a>
        <nav>
          <a href="/" class:list={[{ on: path === '/' }]}>首页</a>
          <a href="/projects" class:list={[{ on: path.startsWith('/projects') }]}>项目</a>
          <a href="/games" class:list={[{ on: path.startsWith('/games') }]}>小游戏</a>
          <a href="/videos" class:list={[{ on: path.startsWith('/videos') }]}>视频</a>
          <a href="/news" class:list={[{ on: path.startsWith('/news') }]}>新闻</a>
          <a href="/records" class:list={[{ on: path.startsWith('/records') }]}>记录</a>
          <a href="/wall" class:list={[{ on: path.startsWith('/wall') }]}>墙</a>
        </nav>
        <a class="auth" id="auth" href="/login/" title="用 GitHub 登录">
          <span>登录</span>
        </a>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container site-footer">
      <span>© {year} {site.name}</span>
      <span>Astro · Cloudflare Pages</span>
    </footer>

    <script>
      // 登录状态是客户端拿的：静态页面上换一个头像/「登录」按钮
      const el = document.getElementById('auth');
      fetch('/api/me', { headers: { accept: 'application/json' } })
        .then((r) => r.json())
        .then((d) => {
          if (!el) return;
          if (d && d.user) {
            el.href = '/login/';
            el.title = '已登录：' + d.user.login;
            el.innerHTML =
              (d.user.avatar ? `<img src="${d.user.avatar}" alt="" width="22" height="22" />` : '') +
              `<span>${d.user.login}</span>`;
            el.classList.add('on');
          }
        })
        .catch(() => {});
    </script>
  </body>
</html>
