{
 "song": "ハルジオン",
 "artist": "YOASOBI",
 "source": "lrclib #13589164 + 机翻",
 "lines": [
  {
   "t": 16.32,
   "ja": "過ぎてゆく時間の中",
   "zh": "在流逝的时光里"
  },
  {
   "t": 20.08,
   "ja": "あなたを思い出す",
   "zh": "记得你"
  },
  {
   "t": 23.89,
   "ja": "物憂げに眺める画面に映った二人",
   "zh": "屏幕上映出的两个人一脸忧郁"
  },
  {
   "t": 29.1,
   "ja": "笑っていた",
   "zh": "正在笑"
  },
  {
   "t": 30.93,
   "ja": "知りたくないほど",
   "zh": "我不想知道"
  },
  {
   "t": 32.76,
   "ja": "知りすぎてくこと",
   "zh": "知道的太多了"
  },
  {
   "t": 34.56,
   "ja": "ただ過ぎる日々に呑み込まれたの",
   "zh": "我被逝去的日子吞噬"
  },
  {
   "t": 38.39,
   "ja": "それでもただもう一度だけ会いたくて",
   "zh": "尽管如此，我还是想再见到你一次"
  },
  {
   "t": 45.02,
   "ja": "あなたの言葉に頷き信じた私を",
   "zh": "我点点头相信了你的话"
  },
  {
   "t": 49.78,
   "ja": "一人置き去りに時間は過ぎる",
   "zh": "当我独自一人时，时间就过去了"
  },
  {
   "t": 53.08,
   "ja": "見えていたはずの",
   "zh": "我应该看到的"
  },
  {
   "t": 55.16,
   "ja": "未来も指の隙間をすり抜けた",
   "zh": "未来也从指缝中溜走"
  },
  {
   "t": 59.73,
   "ja": "戻れない日々の欠片と",
   "zh": "回不去的日子碎片"
  },
  {
   "t": 62.63,
   "ja": "あなたの気配を",
   "zh": "你的存在"
  },
  {
   "t": 64.54,
   "ja": "今でも探してしまうよ",
   "zh": "我还在寻找"
  },
  {
   "t": 67.48,
   "ja": "まだあの日の二人に手を伸ばしてる",
   "zh": "从那天起我仍然与我们两个保持联系。"
  },
  {
   "t": 86.75,
   "ja": "境界線は自分で引いた",
   "zh": "我自己划定了界限。"
  },
  {
   "t": 88.89,
   "ja": "「現実は」って見ないフリをしていた",
   "zh": "我假装没有看到“现实”"
  },
  {
   "t": 91.08,
   "ja": "そんな私じゃ",
   "zh": "这就是我"
  },
  {
   "t": 92.53,
   "ja": "見えない見えない",
   "zh": "我看不见 我看不见"
  },
  {
   "t": 94.26,
   "ja": "境界線の向こうに咲いた",
   "zh": "绽放于国界之外"
  },
  {
   "t": 96.1,
   "ja": "鮮烈な花達も",
   "zh": "花朵也鲜艳"
  },
  {
   "t": 97.97,
   "ja": "本当は見えてたのに",
   "zh": "我实际上可以看到它"
  },
  {
   "t": 100.88,
   "ja": "知らず知らずの内に",
   "zh": "不知不觉中"
  },
  {
   "t": 103.41,
   "ja": "擦り減らした心の扉に鍵をかけたの",
   "zh": "我锁上了疲惫的心门"
  },
  {
   "t": 108.57,
   "ja": "そこにはただ美しさの無い",
   "zh": "那里没有美丽"
  },
  {
   "t": 111.9,
   "ja": "私だけが残されていた",
   "zh": "只剩下我一个人了"
  },
  {
   "t": 115.55,
   "ja": "青過ぎる空に目の奥が染みた",
   "zh": "天空蓝得染红了我的眼眸深处"
  },
  {
   "t": 119.54,
   "ja": "あの日の景色に取りに帰るの",
   "zh": "我会回去看那天的风景"
  },
  {
   "t": 123.25,
   "ja": "あなたが好きだと言ってくれた私を",
   "zh": "你告诉我你爱我"
  },
  {
   "t": 129.97,
   "ja": "誰にも見せずに",
   "zh": "不向任何人展示"
  },
  {
   "t": 131.77,
   "ja": "この手で隠した想いが",
   "zh": "我用这双手隐藏的感情"
  },
  {
   "t": 134.64,
   "ja": "今も私の中で生きている",
   "zh": "在我体内还活着"
  },
  {
   "t": 137.97,
   "ja": "目を閉じてみれば",
   "zh": "如果你闭上眼睛"
  },
  {
   "t": 140.07,
   "ja": "今も鮮やかに蘇る景色と",
   "zh": "风景依然历历在目"
  },
  {
   "t": 144.68,
   "ja": "戻れない日々の欠片が",
   "zh": "回不去的日子碎片"
  },
  {
   "t": 147.64,
   "ja": "映し出したのは",
   "zh": "显示的是"
  },
  {
   "t": 149.43,
   "ja": "蕾のまま閉じ込めた未来",
   "zh": "未来如花蕾般锁住"
  },
  {
   "t": 152.88,
   "ja": "もう一度描き出す",
   "zh": "再画一次"
  },
  {
   "t": 155.96,
   "ja": "あの日のあなたの言葉と",
   "zh": "那天你的话"
  },
  {
   "t": 158.92,
   "ja": "美しい時間と",
   "zh": "美好的时光和"
  },
  {
   "t": 160.87,
   "ja": "二人で過ごしたあの景色が",
   "zh": "那段我们一起度过的风景"
  },
  {
   "t": 164.22,
   "ja": "忘れてた想いと",
   "zh": "我忘记的感情"
  },
  {
   "t": 166.16,
   "ja": "失くしたはずの未来を繋いでいく",
   "zh": "连接到本应失去的未来"
  },
  {
   "t": 170.9,
   "ja": "戻れない日々の続きを歩いていくんだ",
   "zh": "我正在走着无法回去的日子的延续"
  },
  {
   "t": 175.47,
   "ja": "これからも あなたがいなくても",
   "zh": "从今以后，即使没有你"
  },
  {
   "t": 178.83,
   "ja": "あの日の二人に手を振れば",
   "zh": "如果那天我向我们两个挥手"
  },
  {
   "t": 182.76,
   "ja": "確かに動き出した",
   "zh": "它肯定开始移动了"
  },
  {
   "t": 185.86,
   "ja": "未来へ",
   "zh": "走向未来"
  }
 ]
}
